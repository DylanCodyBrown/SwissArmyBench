<Project>
  <!-- Every C# project under blazor/: the style rules of .editorconfig are build errors (the csharp-clean-code skill). -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- IDE0005 (unused usings) needs the documentation file to run in a build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: not every public member needs an XML comment; a short // comment says why where it matters. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
