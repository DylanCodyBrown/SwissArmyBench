<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet's packages are kept here, in blazor/.nuget (ignored by Git), never in the home folder. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
