@* A Plotly figure (interop/plotly.js): the Analyze board's cards and a notebook's figures. The figure is Plotly's
   JSON (fig.to_json()); drawn again when it or the theme changes. A figure that cannot be drawn says why. *@
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject ThemeState Theme

<div class="plotly-host" @ref="_host" role="img" aria-label="@Label"></div>
@if (_problem is not null)
{
    <p class="muted">@_problem</p>
}

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private string? _drawn;
    private string? _problem;

    /// <summary>The figure as Plotly JSON ({"data": [...], "layout": {...}}).</summary>
    [Parameter, EditorRequired]
    public string Figure { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = "Chart";

    protected override void OnInitialized() => Theme.Changed += Redraw;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var wanted = $"{Theme.Effective}\n{Figure}";
        if (wanted == _drawn || Figure.Length == 0)
        {
            return;
        }
        _drawn = wanted;
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/plotly.js");
        var problem = await _module.InvokeAsync<string?>("render", _host, Figure);
        if (problem != _problem)
        {
            _problem = problem;
            StateHasChanged();
        }
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= Redraw;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroy", _host);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is closing: the chart goes with it.
            }
        }
    }
}
