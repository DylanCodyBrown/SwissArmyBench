@* One node of a structure's tree (the classic structureTree.ts): a key and its value; an object or a list folds open
   with its children (the first ones, then Show more); a click selects it (its path shown above the tree). *@

@if (IsBranch)
{
    <details class="tree-node" open="@(Depth < OpenDepth || (Unfold?.Contains(Path) ?? false))">
        <summary class="tree-row @(Selected == Path ? "selected" : string.Empty) @Marks" @oncontextmenu="MenuAsync" @oncontextmenu:preventDefault="OnMenu.HasDelegate" role="treeitem" aria-selected="@(Selected == Path ? "true" : "false")" aria-label="@($"{Name}: {Summary}")" @onclick="() => OnSelect.InvokeAsync(Path)">
            <span class="tree-key">@Name</span> <span class="tree-summary">@Summary</span>
        </summary>
        <div class="tree-children" role="group">
            @foreach (var (key, path, child, index) in Children.Take(_shown))
            {
                <StructureNode Name="@key" Path="@path" Value="child" Depth="Depth + 1" Selected="@Selected" OnSelect="OnSelect"
                               Index="index" Siblings="Count" OnMenu="OnMenu" Marked="Marked" Found="@Found" Unfold="Unfold" />
            }
            @if (Count > _shown)
            {
                <button type="button" class="link tree-more" @onclick="() => _shown += Page">Show @Math.Min(Page, Count - _shown).ToString("N0") more of @((Count - _shown).ToString("N0"))</button>
            }
        </div>
    </details>
}
else
{
    <div class="tree-row leaf @(Selected == Path ? "selected" : string.Empty) @Marks" @oncontextmenu="MenuAsync" @oncontextmenu:preventDefault="OnMenu.HasDelegate" role="treeitem" tabindex="0" aria-selected="@(Selected == Path ? "true" : "false")" @onclick="() => OnSelect.InvokeAsync(Path)" @onkeydown="KeyAsync">
        <span class="tree-key">@Name</span>: <span class="tree-value tree-@Value.ValueKind.ToString().ToLowerInvariant()">@Leaf</span>
    </div>
}

@code {
    // A node's children drawn this many at a time (a list of thousands stays quick); the first levels start open.
    private const int Page = 200;
    private const int OpenDepth = 3;

    private int _shown = Page;

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Path { get; set; } = StructurePath.Root;

    [Parameter, EditorRequired]
    public System.Text.Json.JsonElement Value { get; set; }

    [Parameter]
    public int Depth { get; set; }

    [Parameter]
    public string? Selected { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    /// <summary>A right click (a structure's tab: its node menu); none, the browser's own menu.</summary>
    [Parameter]
    public EventCallback<StructureNodeMenu> OnMenu { get; set; }

    /// <summary>Its place in its list (null: a key of an object), and the list's size.</summary>
    [Parameter]
    public int? Index { get; set; }

    [Parameter]
    public int Siblings { get; set; }

    /// <summary>The search's matches (marked) and the one in front (found).</summary>
    [Parameter]
    public IReadOnlySet<string>? Marked { get; set; }

    [Parameter]
    public string? Found { get; set; }

    /// <summary>Branches opened whatever their depth (the way to a found node).</summary>
    [Parameter]
    public IReadOnlySet<string>? Unfold { get; set; }

    private string Marks => $"{(Marked?.Contains(Path) == true ? "match" : string.Empty)} {(Found == Path ? "found" : string.Empty)}";

    private Task MenuAsync(MouseEventArgs e) => OnMenu.HasDelegate
        ? OnMenu.InvokeAsync(new StructureNodeMenu(Path, Value, Index, Siblings, e.ClientX, e.ClientY))
        : Task.CompletedTask;

    private bool IsBranch => Value.ValueKind is System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array;

    private int Count => Value.ValueKind == System.Text.Json.JsonValueKind.Array ? Value.GetArrayLength() : Value.EnumerateObject().Count();

    private string Summary => Value.ValueKind == System.Text.Json.JsonValueKind.Array ? $"[{Count:N0}]" : $"{{{Count:N0}}}";

    private string Leaf => Value.ValueKind == System.Text.Json.JsonValueKind.String ? $"\"{Value.GetString()}\"" : Value.GetRawText();

    private IEnumerable<(string Key, string Path, System.Text.Json.JsonElement Child, int? Index)> Children =>
        Value.ValueKind == System.Text.Json.JsonValueKind.Array
            ? Value.EnumerateArray().Select((child, at) => ($"[{at}]", StructurePath.Index(Path, at), child, (int?)at))
            : Value.EnumerateObject().Select(p => (p.Name, StructurePath.Key(Path, p.Name), p.Value, (int?)null));

    private Task KeyAsync(KeyboardEventArgs e) => e.Key == "Enter" ? OnSelect.InvokeAsync(Path) : Task.CompletedTask;
}
