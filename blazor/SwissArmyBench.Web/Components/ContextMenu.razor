@* A menu at the pointer (the classic dom.ts showMenu: the right-click menus): its heading, its lines, a click anywhere
   else or Escape closes it; its first line takes focus and the arrow keys move between its lines (shell.js). *@
@inject IJSRuntime Js
@inject BetaState Beta
<div class="menu-shade" @onclick="OnClose" @oncontextmenu="OnClose" @oncontextmenu:preventDefault="true"></div>
<div class="menu context-menu" role="menu" aria-label="@Title" style="@Place" @onkeydown="KeyAsync" @ref="_menu">
    @if (Title.Length > 0)
    {
        <div class="menu-title">@Title</div>
    }
    @foreach (var entry in Entries)
    {
        if (entry.IsSeparator)
        {
            <div class="menu-separator" role="separator"></div>
        }
        else
        {
            <button type="button" class="menu-item" role="menuitem" disabled="@(entry.Disabled is not null)" title="@entry.Disabled" @onclick="() => RunAsync(entry)">
                <Icon Name="@entry.Icon" /> @entry.Label
            </button>
        }
    }
    @if (Beta.On && !NoBetaNote)
    {
        <div class="menu-separator" role="separator"></div>
        <button type="button" class="menu-item" role="menuitem" @onclick="NoteAsync"><Icon Name="edit" /> Leave a note…</button>
    }
</div>

@code {
    // The menu keeps clear of the window's right and bottom edges by this much (a menu is about this wide).
    private const double MenuWidth = 240;

    private ElementReference _menu;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<MenuEntry> Entries { get; set; } = [];

    [Parameter]
    public double X { get; set; }

    [Parameter]
    public double Y { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>A menu that is itself beta mode's (the Beta mark's) leaves out the Leave a note… it already has.</summary>
    [Parameter]
    public bool NoBetaNote { get; set; }

    private string Place => FormattableString.Invariant($"left: min({X}px, calc(100vw - {MenuWidth}px)); top: min({Y}px, calc(100vh - {Entries.Count * 30 + 40}px));");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("sab.menuKeys", _menu);
        }
    }

    private async Task RunAsync(MenuEntry entry)
    {
        await OnClose.InvokeAsync();
        await entry.Run();
    }

    // Leave a note… (beta mode, the classic betaNotes.ts): the note is about this menu's place, by its heading.
    private async Task NoteAsync()
    {
        await OnClose.InvokeAsync();
        Beta.AskNote(Title.Length > 0 ? $"Menu: {Title}" : "Menu");
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        // Escape closes it; Tab too, the focus going on to what is next (the classic dom.ts showEntries).
        if (e.Key is "Escape" or "Tab")
        {
            await OnClose.InvokeAsync();
        }
    }
}
