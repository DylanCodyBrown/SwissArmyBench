@* A Vega-Lite chart (interop/vega.js): the Analyze board's chart cards and Open large. The spec is the server's
   (domain/charts.py), drawn in the theme again when it or the theme changes; a click on a bar, point or heatmap cell
   is told by OnSelect (the cross-filter). A chart that cannot be drawn says why. *@
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject ThemeState Theme

<div class="vega-host @(Large ? "expanded-chart" : string.Empty)" @ref="_host" role="img" aria-label="@Label"></div>
@if (_problem is not null)
{
    <p class="muted">@_problem</p>
}

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<VegaChart>? _self;
    private string? _drawn;
    private string? _problem;

    /// <summary>The chart as Vega-Lite JSON.</summary>
    [Parameter, EditorRequired]
    public string Spec { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = "Chart";

    /// <summary>Scatter, line and area charts zoom with the wheel (Open large).</summary>
    [Parameter]
    public bool Zoomable { get; set; }

    [Parameter]
    public bool Large { get; set; }

    [Parameter]
    public int? Height { get; set; }

    /// <summary>A bar, point or cell clicked: its value as JSON, and a heatmap cell's row value.</summary>
    [Parameter]
    public EventCallback<(string Value, string? Y)> OnSelect { get; set; }

    protected override void OnInitialized() => Theme.Changed += Redraw;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var wanted = $"{Theme.Effective}\n{Spec}";
        if (wanted == _drawn || Spec.Length == 0)
        {
            return;
        }
        _drawn = wanted;
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/vega.js");
        _self ??= DotNetObjectReference.Create(this);
        var options = new { zoomable = Zoomable, large = Large, height = Height };
        var problem = await _module.InvokeAsync<string?>("render", _host, Spec, options, OnSelect.HasDelegate ? _self : null);
        if (problem != _problem)
        {
            _problem = problem;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task Selected(string value, string? y) => InvokeAsync(() => OnSelect.InvokeAsync((value, y)));

    /// <summary>Download image (PNG).</summary>
    public async Task DownloadPngAsync(string title)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("downloadPng", _host, title);
        }
    }

    /// <summary>Download as HTML: its picture in a page of its own.</summary>
    public async Task DownloadHtmlAsync(string title, string? dataset)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("downloadHtml", _host, title, dataset);
        }
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= Redraw;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroy", _host);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is closing: the chart goes with it.
            }
        }
        _self?.Dispose();
    }
}
