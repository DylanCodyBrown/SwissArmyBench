@* A dialog of the app's own: a shade over the page, the heading with Close, the body, the buttons at its foot.
   Escape closes it (as Close). *@
<div class="dialog-shade" @onkeydown="OnKeyAsync">
    <div class="dialog" role="dialog" aria-modal="true" aria-label="@Title">
        <div class="dialog-head">
            <h2>@Title</h2>
            <button type="button" class="btn ghost icon" aria-label="Close" @onclick="OnClose"><Icon Name="close" /></button>
        </div>
        @ChildContent
        @if (Foot is not null)
        {
            <div class="dialog-foot">@Foot</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Foot { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }
}
