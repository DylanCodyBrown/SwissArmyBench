@* An address the app has no page for (an extension's area with no panel, a mistyped address): one plain line,
   never a fake page. *@
<section class="area-page not-yet">
    <h1>@Title</h1>
    <p>@Title is not a page of this app.</p>
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;
}
