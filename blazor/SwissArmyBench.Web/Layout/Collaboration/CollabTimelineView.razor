@* The Collaboration panel's timeline: the threads (each its place, first message, replies, unread, resolved and
   pinned), oldest first. Only what people write (the owner, 2026-11-25: the change log stays out). *@

<ol class="collab-timeline" aria-label="Timeline">
    @foreach (var item in Items)
    {
        <li class="collab-item thread @(item.Unread > 0 ? "unread" : null) @(item.Resolved is null ? null : "resolved")" data-thread="@item.Id">
            <button type="button" class="collab-thread-open" aria-label="@($"Open the thread {item.Title}")" @onclick="() => OnOpen.InvokeAsync(item.Id)">
                <span class="collab-item-head">
                    @if (item.Pinned)
                    {
                        <span class="collab-pinned" title="Pinned"><Icon Name="pin" /></span>
                    }
                    <span class="collab-place">@CollabWords.Place(item)</span>
                    @if (item.Resolved is not null)
                    {
                        <span class="collab-resolved-mark" title="Resolved"><Icon Name="check" /> Resolved</span>
                    }
                    @if (item.Unread > 0)
                    {
                        <span class="collab-unread" aria-label="@($"{item.Unread} unread")">@item.Unread</span>
                    }
                </span>
            </button>
            @if (item.First is { } first)
            {
                <CollabMessageView Message="first" Now="Now" Compact="true" />
            }
            <button type="button" class="collab-replies" @onclick="() => OnOpen.InvokeAsync(item.Id)">
                @(item.Replies switch { 0 => "Reply", 1 => "1 reply", var n => $"{n} replies" })
            </button>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CollabItem> Items { get; set; } = [];

    [Parameter]
    public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    /// <summary>A thread opened (its id).</summary>
    [Parameter]
    public EventCallback<string> OnOpen { get; set; }
}
