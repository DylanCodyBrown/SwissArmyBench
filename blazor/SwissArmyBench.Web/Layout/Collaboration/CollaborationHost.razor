@* The Collaboration panel on every page (the owner, 2026-11-25: "overlay panel only but it should be a show hide
   option on every page and it should overlay not be a stationary panel"): Ctrl+Shift+M or the status bar's button
   shows and hides it; open or closed is kept per kind of window in this browser (interop/collaboration.js). *@
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject CollaborationState State

@if (State.Open)
{
    <CollaborationPanel Kind="@_kind" OnClose="CloseAsync" />
}

@code {
    private IJSObjectReference? _module;
    private IJSObjectReference? _keys;
    private DotNetObjectReference<CollaborationHost>? _self;
    private string _kind = "home";
    private bool _wasOpen;

    protected override void OnInitialized() => State.Changed += Redraw;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/collaboration.js");
            _keys = await _module.InvokeAsync<IJSObjectReference>("installKeys", _self);
            _kind = await _module.InvokeAsync<string>("windowKind");
            if (await _module.InvokeAsync<bool?>("recallOpen", _kind) is true)
            {
                State.SetOpen(true);
            }
            _wasOpen = State.Open;
            await State.StartAsync();
        }
        else if (_module is not null && _wasOpen != State.Open)
        {
            _wasOpen = State.Open;
            await _module.InvokeVoidAsync("rememberOpen", _kind, State.Open);
        }
    }

    [JSInvokable]
    public void Toggle() => State.Toggle();

    private Task CloseAsync()
    {
        State.SetOpen(false);
        return Task.CompletedTask;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        State.Changed -= Redraw;
        if (_keys is not null)
        {
            await _keys.InvokeVoidAsync("stop");
            await _keys.DisposeAsync();
        }
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
        _self?.Dispose();
    }
}
