@* The Collaboration panel's search results: the messages found (their thread's title and the words), newest first;
   each opens its thread. *@

@if (Found.Found.Count == 0)
{
    <p class="collab-empty-words">Nothing found for “@Found.Words”.</p>
}
else
{
    <ol class="collab-timeline collab-found" aria-label="Found">
        @foreach (var found in Found.Found)
        {
            <li class="collab-item">
                <button type="button" class="collab-thread-open" @onclick="() => OnOpen.InvokeAsync(found.Thread)">
                    <span class="collab-place">@found.Title</span>
                    <span class="collab-snippet"><strong>@found.Author?.Name</strong> @found.Snippet</span>
                </button>
                <time class="collab-time" datetime="@found.Time">@CollabWords.When(found.Time, Now)</time>
            </li>
        }
    </ol>
}

@code {
    [Parameter, EditorRequired]
    public CollabSearch Found { get; set; } = default!;

    [Parameter]
    public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    [Parameter]
    public EventCallback<string> OnOpen { get; set; }
}
