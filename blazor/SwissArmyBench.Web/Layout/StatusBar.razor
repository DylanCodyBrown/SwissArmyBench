@* The status bar at every page's foot: the app's name, the open project (its unsaved dot and Save), whether the
   server can be reached, and this front end's own mark with the way back to the classic one. *@
@implements IDisposable
@inject ProjectState Project
@inject LiveUpdates Live
@inject ProjectsClient Projects
@inject Notes Notes
@inject GridStatus Grid
@inject SettingsClient Settings
@inject ProjectSetup Setup
@inject WhatsNewState News

<footer class="status-bar" aria-label="Status">
    <button type="button" class="status-app version-mark" title="@($"{Version}: what's new")" aria-haspopup="dialog" @onclick="News.OpenAsync">@Version</button>
    @if (Project.Current is { } open)
    {
        <span class="status-project">
            @* The open project on every page; a click goes to Home's summary of it. *@
            <a class="status-project-name" href="./" title="@($"{open.Path}: its summary on Home")" aria-label="@($"Project {open.Name}: its summary")"><Icon Name="folder" /> @open.Name</a>
            @if (open.Dirty)
            {
                <span class="dirty-dot" aria-label="Unsaved changes">●</span>
                <button type="button" class="btn small ghost" @onclick="SaveAsync">Save</button>
            }
        </span>
    }
    else
    {
        <span class="status-project muted">No project open</span>
    }
    @if (!Live.Connected)
    {
        <span class="status-offline" role="status"><Icon Name="warning" /> Not connected to the app's server</span>
    }
    <span class="status-spacer"></span>
    @if (Grid.Rows is { } rows)
    {
        <span class="status-rows" role="status" aria-label="Rows">@rows@(Grid.Preview is { } upto ? $" · previewing after step {upto}" : string.Empty)</span>
    }
    @if (Grid.Words is { } selected)
    {
        <span class="status-selection" role="status" aria-label="Selection">@selected</span>
    }
    @if (Grid.Budget is { } budget)
    {
        <a class="meter warn" href="tables?tables=1" title="Over 80% of the data budget is in use. Open the Tables list to remove some.">
            <span class="meter-bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Grid.BudgetShare" aria-label="Data budget used"><span style="@($"width: {Math.Min(100, Grid.BudgetShare)}%")"></span></span>
            @budget
        </a>
    }
    @if (Setup.Running && Setup.Hidden && Setup.Now is { } setup)
    {
        <button type="button" class="btn small ghost status-setup" title="@setup.Words" @onclick="Setup.Bring"><Icon Name="environment" /> Setting up · @setup.Done of @setup.Total</button>
    }
    <AreaMarks />
    <FooterMarks />
</footer>

@code {
    private string Version { get; set; } = "Swiss Army Bench";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var updates = await Settings.UpdatesAsync();
            Version = $"{updates.Name} {updates.Current}".Trim();
        }
        catch (ApiException)
        {
            // The name alone.
        }
    }

    protected override void OnInitialized()
    {
        Project.Changed += Redraw;
        Live.Changed += Redraw;
        Grid.Changed += Redraw;
        Setup.Changed += Redraw;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    private async Task SaveAsync()
    {
        try
        {
            await Projects.SaveAsync();
            await Project.RefreshAsync();
        }
        catch (ApiException error)
        {
            Notes.Error(error);
        }
    }

    public void Dispose()
    {
        Project.Changed -= Redraw;
        Live.Changed -= Redraw;
        Grid.Changed -= Redraw;
        Setup.Changed -= Redraw;
    }
}
