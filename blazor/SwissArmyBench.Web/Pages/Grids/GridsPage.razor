@* The Grids page (the classic home page's grids): a tab per open table, "+" the New query page; the active grid
   (AG Grid, rows paged from the server, selected like Excel), the ribbon above it (Table, Transformations: the
   steps strip, Column: the selected columns), the right-click menus on cells and headers, a step's editor, and a
   column's card on a header click. The selection's numbers are in the status bar. ?grid= names the tab shown.
   The tools are in GridsPage.Tools.cs. *@
@page "/grids"

<section class="area-page grids-page">
    <div class="grid-tabs" role="tablist" aria-label="Open tables">
        @foreach (var tab in _tabs)
        {
            <a role="tab" class="grid-tab @(tab.Grid == _active ? "current" : string.Empty)" aria-selected="@(tab.Grid == _active ? "true" : "false")" href="@($"grids?grid={Uri.EscapeDataString(tab.Grid)}")">
                <Icon Name="table" /> @tab.Dataset
                @if (tab.Steps > 0)
                {
                    <span class="chip">@tab.Steps</span>
                }
            </a>
        }
        <a role="tab" class="grid-tab new-tab @(IsNewQuery ? "current" : string.Empty)" href="grids?new=1" aria-label="New query"><Icon Name="plus" /></a>
    </div>
    <ErrorNote Error="_error" OnRetry="LoadAsync" OnClose="() => _error = null" />
    @if (IsNewQuery || (_tabs.Count == 0 && _loaded))
    {
        <NewQuery OnMade="MadeAsync" />
    }
    else if (_info is { } info)
    {
        <div class="grid-title-row">
            <h1 class="grid-title"><Icon Name="table" /> @info.Title</h1>
            <span class="muted">@(_rows?.ToString("N0") ?? info.RowCount.ToString("N0")) rows · @info.Columns.Count columns</span>
            <span class="status-spacer"></span>
            <button type="button" class="btn small" disabled="@(!info.CanUndo)" @onclick="UndoAsync"><Icon Name="undo" /> Undo</button>
            <button type="button" class="btn small" disabled="@(!info.CanRedo)" @onclick="RedoAsync"><Icon Name="redo" /> Redo</button>
            <button type="button" class="btn small ghost" @onclick="CloseTableAsync"><Icon Name="close" /> Close table</button>
        </div>
        <Ribbon Info="info" Selection="_selection" ConnectionLabel="@ConnectionLabel" OnTool="RunToolAsync">
            <Steps>
                <StepsStrip Info="info" OnToggle="ToggleStepAsync" OnDelete="DeleteStepAsync" OnEdit="EditStep" />
            </Steps>
        </Ribbon>
        <div class="grid-body">
            <AgGrid @ref="_grid" GridId="@info.Grid" Columns="info.Columns" OnHeaderClicked="ShowColumn" OnCounted="Counted" OnChanged="ReloadInfoAsync" OnFailed="RowsFailed"
                    OnSelectionChanged="SelectionChangedAsync" OnCellMenu="CellMenu" OnHeaderMenu="HeaderMenu" OnSaid="Say" />
            @if (_column is { } column)
            {
                <ColumnCard Grid="@info.Grid" Column="@column" Type="@TypeOf(column)" AllColumns="info.Columns.Select(c => c.Name).ToList()" OnStep="AddStepAsync" OnClose="() => _column = null" />
            }
        </div>
    }
    else if (_loaded)
    {
        <div class="loading-block">Loading the table…</div>
    }
</section>
@if (_variantOf is { } variantOf)
{
    <SwissArmyBench.Web.Pages.Connections.Sandbox.SandboxVariantDialog Origin="@variantOf" OnClose="_ => _variantOf = null" />
}
@if (_info is { } open)
{
    @if (_editor is { } editor)
    {
        <StepEditor Kind="@editor.Kind" Grid="@open.Grid" Columns="EnteringColumns(editor.Index)" Start="editor.Start" Index="editor.Index" Save="SaveStepAsync" OnClose="() => _editor = null" />
    }
    @switch (_dialog)
    {
        case "matching":
            <MatchingDialog Settings="open.Settings" Save="SaveMatchingAsync" OnClose="CloseDialog" />
            break;
        case "export":
            <ExportDialog Info="open" Selection="_selection.Descriptor" OnClose="CloseDialog" />
            break;
        case "profile":
            <TableProfileDialog Grid="@open.Grid" Dataset="@open.Dataset" OnClose="CloseDialog" />
            break;
        case "keyfinder":
            <KeyFinderDialog Grid="@open.Grid" Dataset="@open.Dataset" OnClose="CloseDialog" />
            break;
        case "code":
            <CodeDialog Grid="@open.Grid" Dataset="@open.Dataset" OnClose="CloseDialog" />
            break;
        case "connection":
            <ConnectionDialog Table="@open.Dataset" Grid="@open.Grid" Current="_connection" OnSwapped="SwappedAsync" OnClose="CloseDialog" />
            break;
        default:
            break;
    }
    @if (_menu is { } menu)
    {
        <ContextMenu Title="@menu.Title" Entries="menu.Entries" X="menu.X" Y="menu.Y" OnClose="() => _menu = null" />
    }
}
