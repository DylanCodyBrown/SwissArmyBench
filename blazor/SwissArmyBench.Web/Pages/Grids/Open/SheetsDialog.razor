@* Which sheets of a workbook to open (the classic openFile.ts pickSheets): every sheet, the first ticked; each one
   opens as its own tab. *@

<AppDialog Title="@($"Open {File.Split('/', '\\').Last()}")" OnClose="() => OnPicked.InvokeAsync([])">
    <ChildContent>
        <div class="sheet-list">
            @foreach (var sheet in Sheets)
            {
                <label class="field-flag check-row"><input type="checkbox" aria-label="@sheet" checked="@_ticked.Contains(sheet)" @onchange="e => Tick(sheet, e.Value is true)" /> <span>@sheet</span></label>
            }
        </div>
    </ChildContent>
    <Foot>
        <button type="button" class="btn" @onclick="() => OnPicked.InvokeAsync([])">Cancel</button>
        <button type="button" class="btn primary" @onclick="() => OnPicked.InvokeAsync(Sheets.Where(_ticked.Contains).ToList())"><Icon Name="folder" /> Open</button>
    </Foot>
</AppDialog>

@code {
    private readonly HashSet<string> _ticked = [];

    [Parameter, EditorRequired]
    public string File { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Sheets { get; set; } = [];

    /// <summary>The sheets ticked (none: cancelled).</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> OnPicked { get; set; }

    protected override void OnInitialized()
    {
        if (Sheets.Count > 0)
        {
            _ticked.Add(Sheets[0]);
        }
    }

    private void Tick(string sheet, bool on)
    {
        if (on)
        {
            _ticked.Add(sheet);
        }
        else
        {
            _ticked.Remove(sheet);
        }
    }
}
