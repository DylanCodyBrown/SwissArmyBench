@* A column's card (the classic headerCard.ts and the column tools): its numbers (rows, blanks, distinct, range,
   the most common values) and its tools as grid steps: sort, keep rows where…, remove the column, rename it. *@

<aside class="column-card" aria-label="@($"Column {Column}")">
    <div class="dialog-head">
        <h2>@Column</h2>
        <span class="chip">@Type</span>
        <button type="button" class="btn ghost icon" aria-label="Close" @onclick="OnClose"><Icon Name="close" /></button>
    </div>
    <ErrorNote Error="_error" OnClose="() => _error = null" />
    @if (_profile is null)
    {
        <div class="loading-block">Reading the column…</div>
    }
    else
    {
        <dl class="terms">
            <dt>Rows</dt><dd>@_profile.Rows.ToString("N0")</dd>
            <dt>Blanks</dt><dd>@_profile.Blanks.ToString("N0") (@_profile.BlankPercent.ToString("0.#")%)</dd>
            <dt>Distinct</dt><dd>@_profile.Distinct.ToString("N0")</dd>
            @if (_profile.Min.ValueKind != JsonValueKind.Undefined)
            {
                <dt>Range</dt><dd>@Text(_profile.Min) to @Text(_profile.Max)</dd>
            }
            @if (_profile.Mean is { } mean)
            {
                <dt>Average</dt><dd>@mean.ToString("N2")</dd>
            }
        </dl>
        @if (_profile.TopValues is { Count: > 0 } top)
        {
            <h3>Most common</h3>
            <ul class="plain-list">
                @foreach (var value in top.Take(MostShown))
                {
                    <li><span class="mono">@Text(value.Value)</span> <span class="muted">@value.Count</span></li>
                }
            </ul>
        }
    }
    <h3>Tools</h3>
    <div class="form-row">
        <button type="button" class="btn small" @onclick='() => StepAsync("sort", new { keys = new[] { new[] { Column, "asc" } } })'><Icon Name="sortup" /> Sort ascending</button>
        <button type="button" class="btn small" @onclick='() => StepAsync("sort", new { keys = new[] { new[] { Column, "desc" } } })'><Icon Name="sortdown" /> Sort descending</button>
    </div>
    <div class="form-row keep-rows">
        <span>Keep rows where it</span>
        <select aria-label="Condition" @bind="_op">
            @foreach (var (op, words) in _conditions)
            {
                <option value="@op">@words</option>
            }
        </select>
        @if (!_noValue.Contains(_op))
        {
            <input aria-label="Value" @bind="_value" />
        }
        <button type="button" class="btn small" @onclick="KeepAsync"><Icon Name="filter" /> Keep</button>
    </div>
    <div class="form-row">
        <button type="button" class="btn small" @onclick="RenameAsync"><Icon Name="rename" /> Rename…</button>
        <button type="button" class="btn small danger" @onclick="RemoveAsync"><Icon Name="exclude" /> Remove the column</button>
    </div>
</aside>
