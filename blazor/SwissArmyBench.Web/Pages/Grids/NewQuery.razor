@* The New query page (the classic startView.ts, reduced): a DuckDB query over the open tables and the connections'
   tables ([Shop].orders) made a new table; with no table open, Try it with sample data. The query box is plain text
   here (Monaco comes with the Notebooks and Scripts pages). *@
@inject GridsClient Grids
@inject ApiClient Api

<div class="new-query">
    <h1>New query</h1>
    <p class="muted">DuckDB SQL over the open tables and any connection's tables, named by the connection: <code>SELECT * FROM [Shop].orders</code>.</p>
    <ErrorNote Error="_error" OnClose="() => _error = null" />
    <label class="form-row"><span>Name</span><input class="query-name" @bind="_name" /></label>
    <textarea class="mono query-sql" rows="8" aria-label="SQL" @bind="_sql" placeholder="SELECT …"></textarea>
    <div class="form-row">
        <button type="button" class="btn primary" disabled="@_running" @onclick="RunAsync"><Icon Name="play" /> Run as a new table</button>
        <button type="button" class="btn" disabled="@_running" @onclick="SampleAsync">Try it with sample data</button>
    </div>
</div>

@code {
    private string _name = "query";
    private string _sql = string.Empty;
    private bool _running;
    private Exception? _error;

    /// <summary>A table was made: its grid's id.</summary>
    [Parameter]
    public EventCallback<string> OnMade { get; set; }

    private async Task RunAsync()
    {
        _running = true;
        try
        {
            var made = await Grids.QueryAsync(_name.Trim().Length == 0 ? "query" : _name.Trim(), _sql);
            _error = null;
            if (made.TryGetProperty("grid", out var grid) && grid.GetString() is { } id)
            {
                await OnMade.InvokeAsync(id);
            }
        }
        catch (ApiException error)
        {
            _error = error;
        }
        _running = false;
    }

    /// <summary>The made-up sample store (customers, products, orders): its first table shown.</summary>
    private async Task SampleAsync()
    {
        _running = true;
        try
        {
            var made = await Api.PostAsync<JsonElement>("/samples/store");
            var first = made.GetProperty("tables").EnumerateArray().First().GetProperty("grid").GetString();
            if (first is not null)
            {
                await OnMade.InvokeAsync(first);
            }
        }
        catch (ApiException error)
        {
            _error = error;
        }
        _running = false;
    }
}
