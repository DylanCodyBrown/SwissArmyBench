@* Export (the classic exportDialog.ts): what (the view, the selection, some columns, the whole source, the
   profile), the format and its options, then Download or Save to the export folder. Logic in
   ExportDialog.razor.cs. *@

<AppDialog Title="Export" OnClose="OnClose">
    <ChildContent>
        <fieldset class="fieldset">
            <legend>What and where</legend>
            <div class="form-grid">
                <label class="field"><span>Rows</span>
                    <select aria-label="Rows" @bind="_scope">
                        <option value="view">Current view</option>
                        @if (Selection is not null)
                        {
                            <option value="selection">Selection</option>
                        }
                        <option value="columns">Some columns</option>
                        <option value="source">Whole source (no steps)</option>
                        <option value="profile">Profile table</option>
                    </select>
                </label>
                <label class="field"><span>Format</span>
                    <select aria-label="Format" @bind="_format">
                        <option value="csv">CSV (.csv)</option>
                        <option value="txt">Delimited text (.txt)</option>
                        <option value="xlsx">Excel (.xlsx)</option>
                        <option value="parquet">Parquet (.parquet)</option>
                    </select>
                </label>
                <label class="field"><span>File name</span><input type="text" aria-label="File name" @bind="_file" /></label>
            </div>
        </fieldset>
        @if (_scope == "columns")
        {
            <fieldset class="fieldset">
                <legend>Columns</legend>
                <div class="form-grid" role="group" aria-label="Columns to export">
                    @foreach (var column in Info.Columns)
                    {
                        var name = column.Name;
                        <label class="check"><input type="checkbox" checked="@_columns.Contains(name)" @onchange="e => Pick(name, e.Value is true)" /> @name</label>
                    }
                </div>
            </fieldset>
        }
        <fieldset class="fieldset">
            <legend>Format options</legend>
            @if (_format is "csv" or "txt")
            {
                <div class="form-grid">
                    <label class="field"><span>Delimiter</span>
                        <select aria-label="Delimiter" @bind="_delimiter">
                            <option value="comma">comma</option>
                            <option value="tab">tab</option>
                            <option value="pipe">pipe |</option>
                            <option value="semicolon">semicolon ;</option>
                        </select>
                    </label>
                    <label class="check"><input type="checkbox" @bind="_header" /> Header row</label>
                    <label class="check"><input type="checkbox" @bind="_bom" /> UTF-8 BOM (for Excel)</label>
                    <label class="check"><input type="checkbox" @bind="_neutralize" /> Neutralize formula-like text</label>
                </div>
            }
            else if (_format == "xlsx")
            {
                <label class="field"><span>Sheet name</span><input type="text" aria-label="Sheet name" @bind="_sheet" /></label>
            }
            @if (_format is "xlsx" or "parquet")
            {
                <label class="check"><input type="checkbox" @bind="_provenance" /> Include provenance</label>
            }
        </fieldset>
        <ErrorNote Error="_error" OnClose="() => _error = null" />
    </ChildContent>
    <Foot>
        <button type="button" class="btn" @onclick="OnClose">Cancel</button>
        <button type="button" class="btn" title="~/.swissarmybench/exports" @onclick="SaveAsync"><Icon Name="save" /> Save to export folder</button>
        <button type="button" class="btn primary" @onclick="DownloadAsync"><Icon Name="export" /> Download</button>
    </Foot>
</AppDialog>
