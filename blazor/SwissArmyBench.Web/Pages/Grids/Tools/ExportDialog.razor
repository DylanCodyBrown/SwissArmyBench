@* Export (the classic exportDialog.ts): what (the view, the selection, some columns, the whole source, the
   profile), the format and its options, then Download or Save to the export folder. Logic in
   ExportDialog.razor.cs. *@

<AppDialog Title="Export" OnClose="OnClose">
    <ChildContent>
        <fieldset class="fieldset">
            <legend>What and where</legend>
            <div class="form-grid">
                <label class="field"><span>Rows</span>
                    <select aria-label="Rows" @bind="_scope">
                        <option value="view">Current view</option>
                        @if (Selection is not null)
                        {
                            <option value="selection">@SelectionLabel</option>
                        }
                        <option value="columns">Some columns</option>
                        <option value="source">Whole source (no steps)</option>
                        <option value="profile">Profile table</option>
                    </select>
                </label>
                <label class="field"><span>Format</span>
                    <select aria-label="Format" @bind="_format">
                        <option value="csv">CSV (.csv)</option>
                        <option value="txt">Delimited text (.txt)</option>
                        <option value="xlsx">Excel (.xlsx)</option>
                        <option value="parquet">Parquet (.parquet)</option>
                    </select>
                </label>
                <label class="field"><span>File name</span><input type="text" aria-label="File name" @bind="_file" /></label>
            </div>
        </fieldset>
        @if (_scope == "columns")
        {
            <fieldset class="fieldset">
                <legend>Columns</legend>
                <div class="code-toolbar">
                    <button type="button" class="btn small" @onclick="() => SetAll(true)">Select all columns</button>
                    <button type="button" class="btn small" @onclick="() => SetAll(false)">Clear</button>
                    <span class="hint">@_columns.Count of @Info.Columns.Count selected</span>
                </div>
                <div class="checklist" role="group" aria-label="Columns to export">
                    @foreach (var column in Info.Columns)
                    {
                        var name = column.Name;
                        <label class="check"><input type="checkbox" aria-label="@name" checked="@_columns.Contains(name)" @onchange="e => Pick(name, e.Value is true)" /> @name</label>
                    }
                </div>
            </fieldset>
        }
        <fieldset class="fieldset">
            <legend>Format options</legend>
            @if (_format is "csv" or "txt")
            {
                <div class="form-grid">
                    <label class="field"><span>Delimiter</span>
                        <select aria-label="Delimiter" @bind="_delimiter">
                            <option value="comma">comma</option>
                            <option value="tab">tab</option>
                            <option value="pipe">pipe |</option>
                            <option value="semicolon">semicolon ;</option>
                        </select>
                    </label>
                    <label class="field"><span>Line endings</span>
                        <select aria-label="Line endings" @bind="_lineEnding">
                            <option value="windows">Windows (CRLF)</option>
                            <option value="unix">Unix (LF)</option>
                        </select>
                    </label>
                    <label class="field"><span>Blank cells as</span><input type="text" placeholder="(empty)" aria-label="Blank cells as" @bind="_blank" /></label>
                    <label class="check"><input type="checkbox" aria-label="Header row" @bind="_header" /> Header row</label>
                    <label class="check"><input type="checkbox" aria-label="Quote every cell" @bind="_quoteAll" /> Quote every cell</label>
                    <label class="check"><input type="checkbox" aria-label="UTF-8 BOM (for Excel)" @bind="_bom" /> UTF-8 BOM (for Excel)</label>
                    <label class="check"><input type="checkbox" aria-label="Neutralize formula-like text" @bind="_neutralize" /> Neutralize formula-like text</label>
                </div>
                @if (!_neutralize)
                {
                    <p class="warning-text">⚠ Formula-like text may run in Excel.</p>
                }
            }
            else if (_format == "xlsx")
            {
                <div class="form-grid">
                    <label class="field"><span>Sheet name</span><input type="text" aria-label="Sheet name" @bind="_sheet" /></label>
                    <label class="check"><input type="checkbox" aria-label="Cut text over 32,767 characters" @bind="_cutLong" /> Cut text over 32,767 characters</label>
                </div>
            }
            else if (_format == "parquet")
            {
                <label class="field"><span>Compression</span>
                    <select aria-label="Compression" @bind="_compression">
                        <option value="snappy">Snappy</option>
                        <option value="zstd">Zstandard</option>
                    </select>
                </label>
            }
            @if (_format is "xlsx" or "parquet")
            {
                <label class="check"><input type="checkbox" aria-label="Include provenance" @bind="_provenance" /> Include provenance</label>
            }
        </fieldset>
        <ErrorNote Error="_error" OnClose="() => _error = null" />
    </ChildContent>
    <Foot>
        <button type="button" class="btn" @onclick="OnClose">Cancel</button>
        <button type="button" class="btn" title="~/.swissarmybench/exports" disabled="@_busy" @onclick="SaveAsync"><Icon Name="save" /> @(_busy && _saving ? "Saving…" : "Save to export folder")</button>
        <button type="button" class="btn primary" disabled="@_busy" @onclick="DownloadAsync"><Icon Name="export" /> @(_busy && !_saving ? "Exporting…" : "Download")</button>
    </Foot>
</AppDialog>
