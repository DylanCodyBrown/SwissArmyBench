@* The Projects page's Tour button (the classic tourButton.ts), with the "New here? Take the tour" bubble beside it
   until the tour is opened once or put away with Not now (kept in this browser), and What's new beside it (every
   release's New features and Bug fixes). The tour and What's New themselves are the layout's. *@
@implements IDisposable
@inject TourState Tour
@inject WhatsNewState News

@if (Tour.Seen)
{
    <button type="button" class="btn ribbon-btn tour-btn" aria-haspopup="dialog" title="What everything means: a guided tour" @onclick="Tour.OpenTourAsync"><Icon Name="help" /> Tour</button>
}
else
{
    <span class="tour-slot">
        <button type="button" class="btn ribbon-btn tour-btn tour-new" aria-haspopup="dialog" title="What everything means: a guided tour" @onclick="Tour.OpenTourAsync"><Icon Name="help" /> Tour</button>
        <span class="tour-bubble">
            <button type="button" class="tour-bubble-go" @onclick="Tour.OpenTourAsync">New here? Take the tour</button>
            <button type="button" class="btn ghost icon" aria-label="Not now" title="Not now" @onclick="Tour.MarkSeenAsync"><Icon Name="close" /></button>
        </span>
    </span>
}

<button type="button" class="btn ribbon-btn whatsnew-btn" aria-haspopup="dialog" title="What's new: each release's new features and bug fixes" @onclick="News.OpenAsync"><Icon Name="star" /> What's new</button>

@code {
    protected override void OnInitialized() => Tour.Changed += Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tour.Changed -= Redraw;
}
