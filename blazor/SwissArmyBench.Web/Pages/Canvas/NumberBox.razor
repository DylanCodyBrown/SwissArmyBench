@* A whole number in a range (the classic canvasPage.ts numberBox): a value outside it is put back. *@
<label class="@ClassName">
    <span class="@LabelClass">@Label</span>
    <input type="number" class="cvs-num" value="@_shown" min="@Lowest" max="@Highest" aria-label="@Label" disabled="@Disabled" @onchange="ChangedAsync" />
</label>

@code {
    private int _shown;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public int Lowest { get; set; }

    [Parameter]
    public int Highest { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string ClassName { get; set; } = "cvs-field";

    [Parameter]
    public string? LabelClass { get; set; }

    [Parameter]
    public EventCallback<int> OnValue { get; set; }

    protected override void OnParametersSet() => _shown = Value;

    private async Task ChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value as string, out var value) && value >= Lowest && value <= Highest)
        {
            _shown = value;
            await OnValue.InvokeAsync(value);
            return;
        }
        // Put back: drawn once with another value, then the value again, so the box's text follows.
        _shown = Value + 1;
        StateHasChanged();
        await Task.Yield();
        _shown = Value;
    }
}
