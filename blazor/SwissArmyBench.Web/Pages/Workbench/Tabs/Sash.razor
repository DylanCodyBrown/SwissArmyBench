@* The sash between two groups (the classic workbenchGroups.ts sash): dragged, or the arrow keys, give the group
   before it a larger or smaller share. *@
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="wb-gsash @(Split.Row ? "row" : "column")" role="separator" tabindex="0" aria-orientation="@(Split.Row ? "vertical" : "horizontal")"
     aria-label="Resize groups" @ref="_element" @onkeydown="KeyAsync"></div>

@code {
    // An arrow key moves the sash by this share of the pair's room.
    private const double KeyStep = 0.05;

    private ElementReference _element;
    private DotNetObjectReference<Sash>? _self;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public TabSplit Split { get; set; } = default!;

    [Parameter, EditorRequired]
    public int Index { get; set; }

    [Parameter]
    public EventCallback OnResized { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/workbench.js");
            await _module.InvokeVoidAsync("sash", _element, _self, Split.Row);
        }
    }

    [JSInvokable]
    public Task Resized(double fraction)
    {
        TabLayout.Resize(Split, Index, fraction);
        return OnResized.InvokeAsync();
    }

    private Task KeyAsync(KeyboardEventArgs e)
    {
        var by = (e.Key, Split.Row) switch
        {
            ("ArrowLeft", true) or ("ArrowUp", false) => -KeyStep,
            ("ArrowRight", true) or ("ArrowDown", false) => KeyStep,
            _ => 0,
        };
        if (by == 0)
        {
            return Task.CompletedTask;
        }
        var pair = Split.Sizes[Index - 1] + Split.Sizes[Index];
        return Resized(Split.Sizes[Index - 1] / pair + by);
    }

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // the page is going
            }
        }
    }
}
