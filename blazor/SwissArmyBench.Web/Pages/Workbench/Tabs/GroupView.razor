@* One group of tabs (the classic workbenchGroups.ts group, VS Code's editor group): its tabs (the kind's icon, the
   unsaved dot, the name, Close; a middle click closes, a right click its menu, F2 its Rename…, the arrow keys, Home
   and End move between them), "+" New tab, the document in front's controls, and its documents: each stays drawn while hidden. *@
@inject IJSRuntime Js

<section class="wb-group @Mark @(Focused ? "focused" : string.Empty) @(Only ? "only" : string.Empty)" aria-label="@Name"
         @onfocusin="OnFocus" @onpointerdown="OnFocus">
    <div class="wb-gstrip">
        <div class="wb-tabs" role="tablist" aria-label="Open documents" @onkeydown="KeyAsync">
            @foreach (var key in Group.Tabs)
            {
                var doc = Documents[key];
                var on = key == Group.Active;
                <div class="tab-item wb-tab @(doc.IsBlade ? "mark-plain" : doc.IsNotebook ? "mark-notebook" : "mark-script") @(on ? "active" : string.Empty)" role="tab"
                     aria-selected="@(on ? "true" : "false")" tabindex="@(on ? 0 : -1)" data-key="@key" title="@($"{doc.KindLabel}: {doc.Path ?? doc.Title}")"
                     @onclick="() => OnShow.InvokeAsync(key)" @onmouseup="e => AuxAsync(e, key)"
                     @oncontextmenu="e => OnTabMenu.InvokeAsync((key, e))" @oncontextmenu:preventDefault="true">
                    <span class="wb-tab-icon" title="@doc.KindLabel"><Icon Name="@(doc.IsBlade ? "bolt" : doc.IsWorkbook ? "excel" : doc.CodeFile is not null ? "codeapp" : doc.IsNotebook ? "notebook" : doc.IsSql ? "sql" : doc.TextKind is { } text ? text.Icon : "code")" /></span>
                    <span class="wb-tab-dirty" title="Unsaved changes">@(doc.Dirty ? "●" : string.Empty)</span>
                    <span class="tab-label">@doc.Title</span>
                    @if (doc.Review.Count > 0)
                    {
                        <span class="wb-tab-comments" title="@($"{doc.Review.CountWords} to send to the agent")" aria-label="@doc.Review.CountWords">@doc.Review.Count</span>
                    }
                    <button type="button" class="tab-close" aria-label="@($"Close {doc.Title}")" title="@($"Close {doc.Title}")"
                            @onclick="() => OnClose.InvokeAsync(key)" @onclick:stopPropagation="true"><Icon Name="close" /></button>
                </div>
            }
        </div>
        <button type="button" class="btn ghost icon small wb-tab-new" aria-label="New tab" title="New tab" aria-haspopup="menu" @onclick="OnNewTab"><Icon Name="plus" /></button>
        <span class="wb-grow"></span>
        <div class="wb-gcontrols">
            @if (Group.Active is { } active)
            {
                @Controls(Documents[active])
            }
        </div>
    </div>
    <div class="wb-gbody">
        @foreach (var key in Group.Tabs)
        {
            <div class="wb-doc-body kind-@(Documents[key].CodeFile is not null ? "codefile" : Documents[key].IsWorkbook ? "workbook" : Documents[key].IsNotebook ? "notebook" : Documents[key].IsSql ? "sql" : Documents[key].IsText ? "text" : "script")" hidden="@(key != Group.Active)" @key="key">
                @* The document's review comments: its bar over it, and the comments handed down to its editors. *@
                <ReviewPanel @ref="Documents[key].ReviewPanel" Review="Documents[key].Review" Path="@Documents[key].ReviewPath" Parts="Documents[key].ReviewParts" OnChanged="OnReview" />
                <CascadingValue Value="Documents[key].Review" IsFixed="true">@Content(Documents[key])</CascadingValue>
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public TabGroup Group { get; set; } = default!;

    /// <summary>The group's number on screen, from one.</summary>
    [Parameter]
    public int Number { get; set; } = 1;

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<int, OpenDocument> Documents { get; set; } = default!;

    [Parameter]
    public bool Focused { get; set; }

    [Parameter]
    public bool Only { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<OpenDocument> Content { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<OpenDocument> Controls { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnShow { get; set; }

    [Parameter]
    public EventCallback<int> OnClose { get; set; }

    [Parameter]
    public EventCallback OnFocus { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnNewTab { get; set; }

    [Parameter]
    public EventCallback<(int Key, MouseEventArgs At)> OnTabMenu { get; set; }

    /// <summary>A document's review comments changed (its tab's count is drawn again here).</summary>
    [Parameter]
    public EventCallback OnReview { get; set; }

    /// <summary>F2 on a focused tab: its Rename… (the tab's menu has it too).</summary>
    [Parameter]
    public EventCallback<int> OnRename { get; set; }

    // The middle mouse button.
    private const long MiddleButton = 1;

    private string Name => $"Group {Number}";

    private string Mark => Group.Active is { } active ? Documents[active].IsNotebook ? "mark-notebook" : "mark-script" : string.Empty;

    private Task AuxAsync(MouseEventArgs e, int key) => e.Button == MiddleButton ? OnClose.InvokeAsync(key) : Task.CompletedTask;

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (Group.Active is not { } active || Group.Tabs.Count == 0)
        {
            return;
        }
        if (e.Key == "F2")
        {
            await OnRename.InvokeAsync(active);
            return;
        }
        var at = Group.Tabs.IndexOf(active);
        var count = Group.Tabs.Count;
        int? next = e.Key switch
        {
            "Home" => 0,
            "End" => count - 1,
            "ArrowLeft" => (at - 1 + count) % count,
            "ArrowRight" => (at + 1) % count,
            _ => null,
        };
        if (next is { } to)
        {
            await OnShow.InvokeAsync(Group.Tabs[to]);
            await Js.InvokeVoidAsync("sab.focus", $".wb-tab[data-key='{Group.Tabs[to]}']");
        }
    }
}
