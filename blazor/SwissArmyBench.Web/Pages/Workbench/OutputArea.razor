@* A cell's (or the console's) outputs as they arrive, the error taken apart by the server (what it means, where),
   and the kernel's question when it waits for a line (input(), getpass). An error's traceback goes into its panel. *@

<div class="wb-outputs" aria-live="polite">
    @foreach (var output in Outputs.Where(o => ErrorDetail is null || OutputReader.Type(o) != "error"))
    {
        <OutputView Output="output" />
    }
    @if (ErrorDetail is { } detail)
    {
        <ErrorPanel Detail="detail" Traceback="@Traceback" Document="@Document" OnFix="OnFix" OnGoTo="OnGoTo" OnOpenGrid="OnOpenGrid" />
    }
    @if (Asking is { } asking)
    {
        <form class="wb-input" @onsubmit="AnswerAsync" @onsubmit:preventDefault="true">
            <label class="field"><span>@(asking.Prompt.Length > 0 ? asking.Prompt : "The code asks for a line")</span>
                <input type="@(asking.Password ? "password" : "text")" aria-label="@(asking.Prompt.Length > 0 ? asking.Prompt : "Input")" @bind="_line" autocomplete="off" />
            </label>
            <button type="submit" class="btn small">Send</button>
        </form>
    }
</div>

@code {
    private string _line = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<System.Text.Json.JsonElement> Outputs { get; set; } = [];

    [Parameter]
    public System.Text.Json.JsonElement? ErrorDetail { get; set; }

    [Parameter]
    public (string Prompt, bool Password)? Asking { get; set; }

    /// <summary>The line typed for the kernel's question.</summary>
    [Parameter]
    public EventCallback<string> OnAnswer { get; set; }

    private async Task AnswerAsync()
    {
        var line = _line;
        _line = string.Empty;
        await OnAnswer.InvokeAsync(line);
    }

    /// <summary>The document's name, for the agent's title.</summary>
    [Parameter]
    public string Document { get; set; } = "the Workbench";

    [Parameter]
    public EventCallback<SwissArmyBench.Web.Api.Workbench.RunErrorFix> OnFix { get; set; }

    [Parameter]
    public EventCallback<SwissArmyBench.Web.Api.Workbench.RunErrorFrame> OnGoTo { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenGrid { get; set; }

    /// <summary>Python's traceback of the run's error output, its colours kept (the panel holds it).</summary>
    private string Traceback => Outputs
        .Where(o => OutputReader.Type(o) == "error")
        .Select(OutputReader.ColouredTraceback)
        .LastOrDefault() ?? string.Empty;
}
