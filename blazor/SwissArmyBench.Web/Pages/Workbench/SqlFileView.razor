@* A .sql file (the owner, 2026-11-24: "as new scripts with the full ide experience ... and running"): Monaco in SQL
   with the SQL cell's completion of connections, tables and columns and the lint (DuckDB's parser, else sqlglot in
   the connection's dialect), Run file (F5) and Run selection (Ctrl+Enter: the selected text, else the statement at
   the cursor), and its Output under it: the open table it built (named after the file) with Open in Tables, or the
   failure with its line marked in the code. Where it runs is the dropdown beside Run file (the page's bar), kept in
   the file as its `-- connection:` line. Logic in SqlFileView.razor.cs. *@

<div class="wb-script wb-sql">
    <div class="wb-script-editor">
        <CodeEditor @ref="_editor" Value="@Text" Language="sql" Label="SQL file" Intel="IntelFor" OnChange="TextChangedAsync" OnKey="KeyAsync" OnProblems="OnProblems" />
    </div>
    <section class="wb-console wb-sql-output" aria-label="Output" hidden="@(_built is null && _failed is null && !_running)">
        <div class="wb-console-head">
            <strong>Output</strong>
            <span class="sql-status" role="status">@Status</span>
            <span class="wb-grow"></span>
            @if (_built is { } built)
            {
                <button type="button" class="btn small wb-sql-open" @onclick="() => OnOpenTable.InvokeAsync(built)"><Icon Name="table" /> Open in Tables</button>
            }
            <button type="button" class="btn small ghost" @onclick="ClearAsync">Clear</button>
        </div>
        @if (_failed is { } failed)
        {
            <div class="wb-console-body">
                <div class="wb-error-panel wb-sql-error" role="alert">
                    <strong>@(failed.Line is { } at ? $"Line {at}: " : string.Empty)@failed.Words</strong>
                    @if (failed.Line is { } line)
                    {
                        <button type="button" class="btn small ghost wb-sql-goto" @onclick="() => RevealLineAsync(line)">Go to line @line</button>
                    }
                    @if (failed.Details is { Length: > 0 } details && details != failed.Words)
                    {
                        <details><summary>Details</summary><pre class="mono">@details</pre></details>
                    }
                </div>
            </div>
        }
    </section>
</div>
