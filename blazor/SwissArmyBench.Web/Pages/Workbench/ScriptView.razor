@* A script (the classic workbenchScript.ts): one editor that fills the page, Run file (F5) and Run selection
   (Ctrl+Enter: the selected lines, else the cursor's line) in the document's Python session, and the console under
   it: the runs' outputs as they arrive, and a line of Python typed and run with Enter. Logic in
   ScriptView.razor.cs. *@

<div class="wb-notebook-bar" role="toolbar" aria-label="Script">
    <button type="button" class="btn small primary" title="Run file (F5)" @onclick="RunFileAsync" disabled="@_console.Running"><Icon Name="play" /> Run file</button>
    <button type="button" class="btn small" title="Run selection (Ctrl+Enter)" @onclick="RunSelectionAsync" disabled="@_console.Running"><Icon Name="play" /> Run selection</button>
    <span class="muted wb-problems" role="status">@ProblemWords</span>
</div>
<ErrorNote Error="_error" OnClose="() => _error = null" />
<div class="wb-script">
    <div class="wb-script-editor">
        <CodeEditor @ref="_editor" Value="@Text" Language="python" Label="Script" Intel="IntelFor" OnChange="TextChangedAsync" OnKey="KeyAsync" OnProblems="p => _problems = p" />
    </div>
    <section class="wb-console" aria-label="Console">
        <div class="wb-console-head">
            <strong>Console</strong>
            <button type="button" class="btn small ghost" @onclick="Clear">Clear</button>
        </div>
        <div class="wb-console-body">
            <OutputArea Outputs="_console.Outputs" ErrorDetail="_console.ErrorDetail" Asking="_console.Asking" OnAnswer="AnswerAsync" />
        </div>
        <form class="wb-console-line" @onsubmit="RunLineAsync" @onsubmit:preventDefault="true">
            <span aria-hidden="true">&gt;&gt;&gt;</span>
            <input type="text" aria-label="Python line" placeholder="Type Python and press Enter" @bind="_line" autocomplete="off" spellcheck="false" />
        </form>
    </section>
</div>
