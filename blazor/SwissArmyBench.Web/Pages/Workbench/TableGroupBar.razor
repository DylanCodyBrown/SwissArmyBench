@* A line of the notebook's Tables group (the classic workbenchNotebookTables.ts redraw): the group's heading or one
   table's, each a fold (▾ open, ▸ folded) with its words; a table's note with its cell links (@cell7: a click goes
   to that cell) and Run (its read-only cell run again). *@

<section class="wb-tcell wb-table-line role-@Cell.Role" data-number="@Cell.Number" aria-label="@Words">
    <div class="wb-table-bar">
        <button type="button" class="wb-fold" aria-expanded="@(Folded ? "false" : "true")" @onclick="OnFold">
            <span class="wb-chevron" aria-hidden="true">@(Folded ? "▸" : "▾")</span> @Words
        </button>
        @if (Note.Length > 0)
        {
            <span class="wb-table-note">
                @foreach (var part in NoteParts())
                {
                    if (part.Cell is { } number)
                    {
                        <button type="button" class="link wb-cell-link" title="Cell @number" @onclick="() => OnGoToCell.InvokeAsync(number)" @onclick:stopPropagation="true">@($"@cell{number}")</button>
                    }
                    else
                    {
                        @part.Text
                    }
                }
            </span>
        }
        <span class="spacer"></span>
        @if (Cell.Role == "tables" && Tables > 0)
        {
            <button type="button" class="btn small ghost wb-run-tables" title="Run each table's cell that is not up to date" @onclick="OnRunTables"><Icon Name="play" /> Run tables</button>
        }
        @if (Cell.Role == "table" && Runnable)
        {
            <button type="button" class="btn small ghost wb-run-table" title="Run @Cell.Table's cell" @onclick="() => OnRunTable.InvokeAsync(Cell.Table ?? string.Empty)"><Icon Name="play" /> Run</button>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public CellModel Cell { get; set; } = default!;

    [Parameter]
    public bool Folded { get; set; }

    /// <summary>The group's count of tables (the heading's words).</summary>
    [Parameter]
    public int Tables { get; set; }

    /// <summary>The table's read-only cell is here to run.</summary>
    [Parameter]
    public bool Runnable { get; set; }

    [Parameter]
    public EventCallback OnFold { get; set; }

    [Parameter]
    public EventCallback<int> OnGoToCell { get; set; }

    [Parameter]
    public EventCallback<string> OnRunTable { get; set; }

    /// <summary>The heading's Run tables: every table's read-only cell run again.</summary>
    [Parameter]
    public EventCallback OnRunTables { get; set; }

    private string Words => Cell.Role == "tables"
        ? $"Tables · {Tables} table{(Tables == 1 ? string.Empty : "s")}"
        : Cell.Table ?? string.Empty;

    // A table's heading is "## name" then its note ("orders is made at @cell7").
    private string Note => Cell.Role == "table" ? string.Join(' ', Cell.Source.Split('\n').Skip(1)).Trim() : string.Empty;

    private IEnumerable<(string Text, int? Cell)> NoteParts() =>
        System.Text.RegularExpressions.Regex.Split(Note, @"(@cell\d+)")
            .Where(p => p.Length > 0)
            .Select(p => p.StartsWith("@cell", StringComparison.Ordinal) && int.TryParse(p[5..], out var n) ? (p, (int?)n) : (p, null));
}
