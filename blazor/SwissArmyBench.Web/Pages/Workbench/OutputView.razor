@* One output of a run (the classic workbenchOutputs.ts): a stream's text, an error's traceback, or a result drawn by
   its richest kind: a picture, a Plotly figure, Markdown, HTML (a table) in a frame that runs no script and loads
   nothing, else its text. Logic in OutputView.razor.cs. *@

@switch (OutputReader.Type(Output))
{
    case "stream":
        <AnsiPre Class="@($"wb-text {(OutputReader.Text(Output, "name") == "stderr" ? "wb-stderr" : string.Empty)}")" Text="@OutputReader.Text(Output, "text")" />
        break;
    case "error":
        <AnsiPre Class="wb-error" Text="@OutputReader.ColouredTraceback(Output)" />
        break;
    case "execute_result" or "display_data":
        @if (Picture is { } picture)
        {
            <img class="wb-image" src="@picture" alt="Figure" />
        }
        else if (OutputReader.Data(Output, PlotlyMime) is { } figure)
        {
            <PlotlyChart Figure="@figure" Label="Figure" />
        }
        else if (OutputReader.Data(Output, "text/markdown") is { } markdown)
        {
            <div class="wb-markdown">@((MarkupString)MarkdownText.ToHtml(markdown))</div>
        }
        else if (OutputReader.Data(Output, "text/html") is { } html)
        {
            <iframe class="wb-html" sandbox="allow-same-origin" title="Output" srcdoc="@Framed(html)" onload="sab.fitFrame(this)"></iframe>
        }
        else
        {
            <AnsiPre Text="@(OutputReader.Data(Output, "text/plain") ?? string.Empty)" />
        }
        break;
    default:
        break;
}
