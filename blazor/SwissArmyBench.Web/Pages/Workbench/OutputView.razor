@* One output of a run (the classic workbenchOutputs.ts): a stream's text, an error's traceback, or a result drawn by
   its richest kind: a picture, a Plotly figure, Markdown, HTML (a table) in a frame that runs no script and loads
   nothing, else its text. Logic in OutputView.razor.cs. *@

@switch (OutputReader.Type(Output))
{
    case "stream":
        <AnsiPre Class="@($"wb-text {(OutputReader.Text(Output, "name") == "stderr" ? "wb-stderr" : string.Empty)}")" Text="@OutputReader.Text(Output, "text")" />
        break;
    case "error" when Frames.Count > FoldFrames && !_allFrames:
        <div class="wb-error-folded">
            <AnsiPre Class="wb-error" Text="@string.Join('\n', Frames.Take(FoldFrames / 2))" />
            <button type="button" class="link wb-fold" @onclick="() => _allFrames = true">Show @((Frames.Count - FoldFrames).ToString("N0")) more frames</button>
            <AnsiPre Class="wb-error" Text="@string.Join('\n', Frames.TakeLast(FoldFrames / 2))" />
        </div>
        break;
    case "error":
        <AnsiPre Class="wb-error" Text="@OutputReader.ColouredTraceback(Output)" />
        break;
    case "execute_result" or "display_data":
        @if (Picture is { } picture)
        {
            <figure class="wb-figure"><img class="wb-image" src="@picture" alt="Figure" />
                <button type="button" class="btn small ghost wb-to-sandbox" @onclick='() => SendAsync("image", picture)'><Icon Name="export" /> Send to Analyze</button></figure>
        }
        else if (TableOf(Output) is { } table)
        {
            <figure class="wb-figure wb-result">
                <div class="wb-result-scroll">
                    <table class="wb-result-table">
                        <thead><tr>@for (var i = 0; i < table.Columns.Count; i++) { var at = i; <th scope="col" title="@(at < table.Types.Count ? table.Types[at] : string.Empty)">@table.Columns[at]</th> }</tr></thead>
                        <tbody>@foreach (var row in table.Rows) { <tr>@foreach (var column in table.Columns) { <td>@ResultTable.Cell(row, column)</td> }</tr> }</tbody>
                    </table>
                </div>
                <div class="wb-result-foot"><span class="hint">@table.Said</span>
                    @if (OnOpenTable.HasDelegate && table.Id.Length > 0)
                    {
                        <button type="button" class="btn small ghost wb-to-grid" @onclick="() => OnOpenTable.InvokeAsync(table.Id)"><Icon Name="export" /> Open as grid</button>
                    }
                </div>
            </figure>
        }
        else if (OutputReader.Data(Output, PlotlyMime) is { } figure)
        {
            <figure class="wb-figure"><PlotlyChart Figure="@figure" Label="Figure" />
                <button type="button" class="btn small ghost wb-to-sandbox" @onclick='() => SendAsync("plotly", figure)'><Icon Name="export" /> Send to Analyze</button></figure>
        }
        else if (OutputReader.Data(Output, "text/markdown") is { } markdown)
        {
            <div class="wb-markdown">@((MarkupString)MarkdownText.ToHtml(markdown))</div>
        }
        else if (OutputReader.Data(Output, "text/html") is { } html)
        {
            <iframe class="wb-html" sandbox="allow-same-origin" title="Output" srcdoc="@Framed(html)" onload="sab.fitFrame(this)"></iframe>
            @if (ResultCount is { } count && IsTable(html))
            {
                <button type="button" class="btn small ghost wb-to-grid" @onclick="() => OpenResultAsync(count)"><Icon Name="export" /> Open as grid</button>
            }
        }
        else
        {
            <AnsiPre Text="@(OutputReader.Data(Output, "text/plain") ?? string.Empty)" />
        }
        break;
    default:
        break;
}
