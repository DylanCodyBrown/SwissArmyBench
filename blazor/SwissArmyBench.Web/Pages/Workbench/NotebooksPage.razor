@* The Notebooks page (/notebooks, the classic window sab-notebooks): ?path= opens a notebook, ?new=1 starts one. *@
@page "/notebooks"

<WorkbenchPage Page="notebooks" Path="@PathParameter" New="@(NewParameter is not null)" />

@code {
    [SupplyParameterFromQuery(Name = "path")]
    public string? PathParameter { get; set; }

    [SupplyParameterFromQuery(Name = "new")]
    public string? NewParameter { get; set; }
}
