@* A blade's screen, an IDE (the classic bladeEditor.ts over codeIde.ts; the owner 2026-11-21): one slim bar (the
   name, the unsaved dot, Save Ctrl+S, Save as…, Cancel, Run F5, Properties, "…": Show its file or Copy as your own,
   Export, Remove), Monaco with the server's intelligence, Properties (the header's fields, checked live) closed until
   asked for, and Output | Result | Problems folded until something runs. An edit made outside is noticed (Reload,
   Keep mine). Logic in BladeIde.razor.cs and BladeIde.Run.cs. *@
@implements IDisposable
@using SwissArmyBench.Web.Api.Blades

<div class="code-ide blade-ide">
    <div class="ide-bar" role="toolbar" aria-label="@($"{Name}: blade")">
        <strong class="ide-name">@Name</strong>
        @if (_detail?.Pack is not null)
        {
            <span class="chip ide-readonly">read-only</span>
        }
        @if (Dirty)
        {
            <span class="dirty-dot" role="img" aria-label="Unsaved changes" title="Unsaved changes">●</span>
        }
        <span class="status-spacer"></span>
        @if (_fontPx != BaseFont)
        {
            <button type="button" class="btn small ghost ide-zoom" title="Code size: click for 100% (Ctrl+0)" @onclick="() => ZoomAsync(BaseFont)">@(_fontPx * 100 / BaseFont)%</button>
        }
        <button type="button" class="btn small" title="Save (Ctrl+S)" disabled="@(!Dirty)" @onclick="SaveAsync"><Icon Name="save" /> Save</button>
        <button type="button" class="btn small" @onclick="() => _savingAs = true">Save as…</button>
        <button type="button" class="btn small ghost" disabled="@(!Dirty)" @onclick="CancelAsync">Cancel</button>
        @if (Runnable)
        {
            <button type="button" class="btn small primary" title="Run (F5)" disabled="@_running" @onclick="RunAsync"><Icon Name="play" /> Run</button>
        }
        <button type="button" class="btn small ghost" aria-pressed="@(_properties ? "true" : "false")" @onclick="() => _properties = !_properties">Properties</button>
        <button type="button" class="btn small ghost icon" aria-label="More" title="More" aria-haspopup="menu" @onclick="ShowMenu"><Icon Name="more" /></button>
        <button type="button" class="btn small ghost icon" aria-label="Close" title="Close" @onclick="CloseAsync"><Icon Name="close" /></button>
    </div>
    @if (_outside)
    {
        <div class="wb-elsewhere" role="status">
            <Icon Name="warning" /> <span>Changed elsewhere.</span>
            <button type="button" class="btn small primary" @onclick="ReloadAsync">Reload</button>
            <button type="button" class="btn small line" @onclick="() => _outside = false">Keep mine</button>
        </div>
    }
    <ErrorNote Error="_error" OnClose="() => _error = null" />
    @if (_copyOffer)
    {
        <div class="ide-note-row" role="alert">
            <span>A starter is read-only: copy it as your own to change it.</span>
            <button type="button" class="btn small primary" @onclick="CopyAsOwnAsync"><Icon Name="copy" /> Copy as your own</button>
        </div>
    }
    <div class="ide-main">
        <div class="ide-editor">
            @if (_detail is { } detail)
            {
                <CodeEditor @ref="_editor" Value="@_code" Language="@Language" Label="@($"{Name} code")" ReadOnly="@(detail.Kind == "secret")"
                            Intel="IntelFor" OnChange="ChangedAsync" OnKey="KeyAsync" Zoom="true" />
            }
            else
            {
                <div class="loading-block">Reading the blade…</div>
            }
        </div>
        @if (_properties && _header is { } header)
        {
            <BladePropertiesPanel @ref="_props" Header="header" Detail="_detail" ReadOnly="@(_detail?.Pack is not null)" OnChanged="() => _propsDirty = true" />
        }
    </div>
    @if (_panel is not null)
    {
        <BladeRunPanel Run="_run" Problems="_problems" Tab="@_panel" Name="@Name" OnTab="t => _panel = t" OnFold="() => _panel = null" OnGoTo="GoToLineAsync" />
    }
</div>
@if (_menu is { } menu)
{
    <ContextMenu Title="More" Entries="menu.Entries" X="menu.X" Y="menu.Y" OnClose="() => _menu = null" />
}
@if (_savingAs)
{
    <SaveBladeAsDialog Name="@Name" OnClose="() => _savingAs = false" OnSaved="SavedAsAsync" Code="CodeNow" />
}
