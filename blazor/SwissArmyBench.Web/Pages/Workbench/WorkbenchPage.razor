@* The Notebooks page and the Scripts page (two pages, the owner 2026-11-21; the classic workbenchPage.ts): the
   document's bar (its name and unsaved dot, New, Open…, Save, Save as…), the notebook or the script, the Files and
   Blades panes on the right, and the page's status bar (the Python session with Interrupt and Restart; the panes'
   toggles). With no document, the page's documents to open. Logic in WorkbenchPage.razor.cs. *@
@implements IDisposable

<section class="area-page workbench-page kind-@Kind">
    <header class="wb-doc-bar">
        <h1 class="wb-doc-title"><Icon Name="@(IsNotebooks ? "notebook" : "code")" /> @Title
            @if (_dirty)
            {
                <span class="dirty-dot" aria-label="Unsaved changes">●</span>
            }
        </h1>
        <div class="area-page-actions" role="toolbar" aria-label="Document">
            <button type="button" class="btn small" @onclick="NewAsync"><Icon Name="plus" /> New @KindWord</button>
            <button type="button" class="btn small" @onclick="OpenAsync"><Icon Name="folder" /> Open…</button>
            @if (HasDocument)
            {
                <button type="button" class="btn small primary" title="Save (Ctrl+S)" @onclick="SaveAsync"><Icon Name="save" /> Save</button>
                <button type="button" class="btn small" title="Save as (Ctrl+Shift+S)" @onclick="SaveAsAsync">Save as…</button>
            }
        </div>
    </header>
    <ErrorNote Error="_error" OnClose="() => _error = null" />
    @if (_wrongPage is not null)
    {
        <p class="wb-wrong-page" role="status">@_wrongPage.Value.Words <a href="@_wrongPage.Value.Address">Open it there</a></p>
    }
    <div class="wb-main">
        <div class="wb-document">
            @if (_loading)
            {
                <div class="loading-block">Opening…</div>
            }
            else if (_notebook is not null || (IsNotebooks && _newDocument))
            {
                <NotebookView @ref="_notebookView" @key="_documentKey" Opened="_notebook" Path="@_path" Connections="_connections" OnChanged="MarkDirty" OnPageKey="PageKeyAsync" />
            }
            else if (_script is not null || (!IsNotebooks && _newDocument))
            {
                <ScriptView @ref="_scriptView" @key="_documentKey" Text="@_scriptText" Path="@_path" Saved="!_dirty && _path is not null" OnTextChanged="ScriptChanged" OnPageKey="PageKeyAsync" />
            }
            else
            {
                <WorkbenchLanding Page="@Page" Tree="_tree" Recent="_recent" OnNew="NewAsync" OnOpen="OpenAsync" />
            }
        </div>
        @if (_showFiles)
        {
            <FilesPane Page="@Page" Tree="_tree" Current="@_path" OnRefresh="LoadTreeAsync" />
        }
        @if (_showBlades)
        {
            <BladesPane OnInsert="InsertAsync" />
        }
    </div>
    <footer class="wb-status" aria-label="Python session">
        <span class="wb-session" title="@(Session.Python ?? string.Empty)">
            <Icon Name="python" /> Python session: <strong role="status">@Session.Words</strong>
        </span>
        <button type="button" class="btn small ghost" disabled="@(!Session.Busy)" @onclick="InterruptAsync">Interrupt</button>
        <button type="button" class="btn small ghost" disabled="@(Session.Kernel is null)" @onclick="RestartAsync">Restart</button>
        @if (Session.Said is { } said)
        {
            <span class="muted">@said</span>
        }
        <span class="status-spacer"></span>
        <button type="button" class="btn small ghost" aria-pressed="@(_showFiles ? "true" : "false")" @onclick="ToggleFilesAsync">Files</button>
        <button type="button" class="btn small ghost" aria-pressed="@(_showBlades ? "true" : "false")" @onclick="ToggleBladesAsync">Blades</button>
    </footer>
</section>
