@* The Notebooks page and the Scripts page (two pages, the owner 2026-11-21; the classic workbenchPage.ts and
   workbenchBars.ts): the top bar (the open project's menu, the document in front's name and unsaved dot, Save, Save
   as…, New, Open…, the "…" menu), the documents as tabs in groups (split right or down, each group's row with the
   document's controls), the Files and Blades panes on the right, the status bar (the Python session, Problems, the
   panes' toggles), and the command palette (Ctrl+Shift+P). With no document open, the page's documents to open.
   Logic in WorkbenchPage.razor.cs (the page), .Documents.cs (open, save, close), .Menus.cs (menus and commands). *@
@implements IAsyncDisposable
@using SwissArmyBench.Web.Pages.Workbench.Tabs

<section class="area-page workbench-page kind-@Kind">
    <header class="wb-doc-bar">
        @if (Project.Current is { } project)
        {
            <button type="button" class="btn small ghost wb-project" aria-haspopup="menu" title="@project.Path" @onclick="e => ShowMenuAsync(e, ProjectMenu())">
                <Icon Name="project" /> @project.Name@(project.Dirty ? " ●" : string.Empty)
            </button>
        }
        <h1 class="wb-doc-title" title="@(Front?.Path ?? Front?.Title ?? string.Empty)"><Icon Name="@(IsNotebooks ? "notebook" : "code")" /> @Title
            @if (Front?.Dirty == true)
            {
                <span class="dirty-dot" role="img" aria-label="Unsaved changes" title="Unsaved changes">●</span>
            }
        </h1>
        <div class="area-page-actions" role="toolbar" aria-label="Document">
            <button type="button" class="btn small" disabled="@(Front is null && Project.Current is null)" title="@(Front is null && Project.Current is null ? NothingSaves : "Save (Ctrl+S)")" @onclick="SaveFrontAsync"><Icon Name="save" /> Save</button>
            <button type="button" class="btn small" disabled="@(Front is null)" title="@(Front is null ? NothingSaves : "Save as (Ctrl+Shift+S)")" @onclick="() => SaveAsAsync(Front)"><Icon Name="save" /> Save as…</button>
            <button type="button" class="btn small wb-top-new" @onclick="NewAsync"><Icon Name="plus" /> New @KindWord</button>
            <button type="button" class="btn small" title="Open a notebook or script (Ctrl+O)" @onclick="OpenAsync"><Icon Name="folder" /> Open…</button>
            <button type="button" class="btn small ghost icon" aria-label="Workbench menu" title="More" aria-haspopup="menu" @onclick="e => ShowMenuAsync(e, TopMenu())"><Icon Name="more" /></button>
        </div>
    </header>
    <ErrorNote Error="_error" OnClose="() => _error = null" />
    @if (_wrongPage is not null)
    {
        <p class="wb-wrong-page" role="status">@_wrongPage.Value.Words <a href="@_wrongPage.Value.Address">Open it there</a></p>
    }
    <div class="wb-main">
        <div class="wb-document">
            @if (_loading)
            {
                <div class="loading-block">Opening…</div>
            }
            @if (_documents.Count == 0)
            {
                <WorkbenchLanding Page="@Page" Tree="_tree" Recent="_recent" OnNew="NewAsync" OnOpen="OpenAsync" />
            }
            else
            {
                <div class="wb-layout">
                    <GroupsView Node="_layout.Root" Group="GroupFragment" OnResized="StateHasChanged" />
                </div>
            }
        </div>
        @if (_showFiles)
        {
            <FilesPane Page="@Page" Tree="_tree" Current="@Front?.Path" OnRefresh="LoadTreeAsync" OnNew="NewAsync" OnOpenAt="OpenAtAsync" OnAction="FileActionAsync" />
        }
        @if (_showBlades)
        {
            <BladesPane OnInsert="InsertAsync" />
        }
    </div>
    <footer class="wb-status" aria-label="Python session">
        <span class="wb-session" title="@(Session.Python ?? string.Empty)">
            <Icon Name="python" /> Python session: <strong role="status">@Session.Words</strong>
        </span>
        <button type="button" class="btn small ghost" disabled="@(!Session.Busy)" @onclick="InterruptAsync">Interrupt</button>
        <button type="button" class="btn small ghost" disabled="@(Session.Kernel is null)" @onclick="RestartAsync">Restart</button>
        @if (Session.Said is { } said)
        {
            <span class="muted">@said</span>
        }
        <span class="status-spacer"></span>
        @if (_inlineStatus is { } inline)
        {
            <button type="button" class="btn small ghost wb-inline-status" aria-pressed="@(inline.On ? "true" : "false")" data-on="@(inline.On ? "true" : "false")"
                    title="@(inline.On ? $"Turn {inline.Name} off" : $"Turn {inline.Name} on")" @onclick="ToggleInlineAsync">Completions: @inline.Name · @inline.Words</button>
        }
        @if (Front is not null)
        {
            <span class="muted wb-problems" role="status">@ProblemWords(Front)</span>
        }
        @if (Front is { IsNotebook: true } notebook)
        {
            <button type="button" class="btn small ghost wb-panel-toggle" aria-pressed="@(notebook.NotebookView?.OutlineShown == true ? "true" : "false")" title="The Markdown headings and the named cells"
                    @onclick="() => notebook.NotebookView?.ToggleOutlineAsync() ?? Task.CompletedTask">Outline</button>
        }
        <button type="button" class="btn small ghost" aria-pressed="@(_showFiles ? "true" : "false")" title="Files (Ctrl+B)" @onclick="ToggleFilesAsync">Files</button>
        <button type="button" class="btn small ghost" aria-pressed="@(_showBlades ? "true" : "false")" @onclick="ToggleBladesAsync">Blades</button>
    </footer>
    @if (_menu is { } menu)
    {
        <ContextMenu Title="@menu.Title" Entries="menu.Entries" X="menu.X" Y="menu.Y" OnClose="() => _menu = null" />
    }
    @if (_newProject is { } listing)
    {
        <SwissArmyBench.Web.Pages.Home.NewProjectDialog Listing="listing" OnDone="NewProjectDoneAsync" />
    }
    @if (_ideTitle is { } ideTitle)
    {
        <AppDialog Title="@ideTitle" OnClose="CloseIde">
            <ChildContent>
                @if (_idePlaces is { } places)
                {
                    <SwissArmyBench.Web.Pages.Workbench.Ide.IdeResults Places="places" Current="@Front?.Path" OnGo="GoToPlaceAsync" />
                }
                else if (_idePlan is { } plan)
                {
                    <SwissArmyBench.Web.Pages.Workbench.Ide.IdePreview Plan="plan" />
                }
            </ChildContent>
            <Foot>
                @if (_idePlan is not null)
                {
                    <button type="button" class="btn primary" @onclick="() => GuardAsync(ApplyRenameAsync)">Apply</button>
                    <button type="button" class="btn ghost" @onclick="CloseIde">Cancel</button>
                }
            </Foot>
        </AppDialog>
    }
    @if (_renamingFile is { } renamingPath)
    {
        <SwissArmyBench.Web.Pages.Workbench.Ide.RenameFileDialog Path="@renamingPath" OnClose="() => _renamingFile = null" OnRenamed="RenamedAsync" />
    }
    @if (_searching)
    {
        <SwissArmyBench.Web.Pages.Workbench.Ide.SearchScripts OnClose="() => _searching = false" OnGo="p => { _searching = false; return GoToPlaceAsync(p); }" />
    }
    @if (_palette)
    {
        <CommandPalette Commands="Commands()" Recent="_recentCommands" OnClose="() => _palette = false" OnRun="RunCommandAsync" />
    }
</section>

@code {
    private RenderFragment<TabGroup> GroupFragment => group =>
        @<GroupView Group="group" Number="@(_layout.Groups.ToList().IndexOf(group) + 1)" Documents="_byKey" Focused="group == _layout.Focused" Only="_layout.Groups.Count == 1"
                    Content="DocumentFragment" Controls="ControlsFragment"
                    OnShow="ShowAsync" OnClose="CloseAsync" OnFocus="() => _layout.Focus(group)"
                    OnNewTab="e => ShowMenuAsync(e, NewTabMenu())" OnTabMenu="t => ShowMenuAsync(t.At, TabMenu(t.Key))" />;

    private RenderFragment<OpenDocument> DocumentFragment => doc =>
        @<text>
            @if (doc.Elsewhere is { } elsewhere)
            {
                <div class="wb-elsewhere" role="status">
                    <Icon Name="warning" /> <span>@(elsewhere == "gone" ? "This file is gone." : "Changed elsewhere.")</span>
                    @if (elsewhere == "gone")
                    {
                        <button type="button" class="btn small line" @onclick="() => SaveAsAsync(doc)">Save as…</button>
                        <button type="button" class="btn small ghost" @onclick="() => CloseAsync(doc.Key)">Close</button>
                    }
                    else
                    {
                        <button type="button" class="btn small primary" @onclick="() => GuardAsync(() => ReloadAsync(doc))">Reload</button>
                        <button type="button" class="btn small line" @onclick="() => GuardAsync(() => KeepMineAsync(doc))">Keep mine</button>
                    }
                </div>
            }
            @if (doc.IsNotebook)
            {
                <NotebookView @key="doc.Version" @ref="doc.NotebookView" Kept="doc.Kept" Inline="_inline" Opened="doc.Notebook" Path="@doc.Path" Connections="_connections"
                              OnChanged="() => MarkDirty(doc)" OnPageKey="EditorPageKeyAsync" />
            }
            else
            {
                <ScriptView @ref="doc.ScriptView" Console="doc.Console" Inline="_inline" Text="@doc.ScriptText" Path="@doc.Path" Saved="!doc.Dirty && doc.Path is not null"
                            OnTextChanged="t => ScriptChanged(doc, t)" OnPageKey="EditorPageKeyAsync" OnProblems="p => Problems(doc, p)"
                            OnIde="m => IdeAsync(doc, m)" />
            }
        </text>;

    private RenderFragment<OpenDocument> ControlsFragment => doc =>
        @<text>
            @if (doc.IsNotebook)
            {
                <button type="button" class="btn small line wb-add-cell" aria-label="Add cell" title="Add cell" aria-haspopup="menu" @onclick="e => ShowMenuAsync(e, CellMenu(doc))">
                    <Icon Name="plus" /> <span class="btn-label">Cell</span> <Icon Name="down" />
                </button>
                <button type="button" class="btn small primary wb-run-all" title="Run all (F5)" disabled="@(doc.NotebookView?.RunningAll == true)" @onclick="() => RunMainAsync(doc)"><Icon Name="play" /> <span class="btn-label">Run all</span></button>
            }
            else
            {
                <button type="button" class="btn small primary wb-run-file" title="Run file (F5)" @onclick="() => RunMainAsync(doc)"><Icon Name="play" /> <span class="btn-label">Run file</span></button>
                <button type="button" class="btn small ghost icon wb-debug-start" aria-label="Start debugging" title="Start debugging (Ctrl+Shift+D)" @onclick="() => DebugAsync(doc)"><Icon Name="bug" /></button>
            }
            <button type="button" class="btn small ghost icon wb-save" aria-label="Save" title="Save (Ctrl+S)" @onclick="() => SaveAsync(doc)"><Icon Name="save" /></button>
            <button type="button" class="btn small ghost icon wb-more" aria-label="Document menu" title="More" aria-haspopup="menu" @onclick="e => ShowMenuAsync(e, DocumentMenu(doc))"><Icon Name="more" /></button>
            <button type="button" class="btn small ghost icon wb-full-toggle" aria-label="@(_full ? "Leave full screen" : "Full screen")" title="@(_full ? "Leave full screen (Escape)" : "Full screen (F11)")"
                    aria-pressed="@(_full ? "true" : "false")" @onclick="FullScreenAsync"><Icon Name="@(_full ? "restore" : "max")" /></button>
        </text>;
}
