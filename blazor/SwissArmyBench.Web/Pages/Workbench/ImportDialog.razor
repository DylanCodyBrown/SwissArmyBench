@* Import into the open project (the classic projectImport.ts, the same in the Workbench and the Blades pane): from
   Another project… (a project folder) or A file… (a loose notebook or script), what it offers of the kind asked for,
   each a tick; Import brings them in (a connection or blade the library has is skipped, and said). *@
@inject ImportClient ImportApi
@inject FileChooser Files
@inject Notes Notes

<AppDialog Title="@($"Import {Words}")" OnClose="() => OnDone.InvokeAsync(null)">
    <ChildContent>
        <div class="import-from">
            <button type="button" class="btn" @onclick="FromProjectAsync"><Icon Name="project" /> Another project…</button>
            @if (Kind == "documents")
            {
                <button type="button" class="btn" @onclick="FromFileAsync"><Icon Name="notebook" /> A file…</button>
            }
        </div>
        <ErrorNote Error="_error" OnClose="() => _error = null" />
        @if (_offer is { } offer)
        {
            <div class="import-choices">
                <h3>@(offer.From == "computer" ? "This computer" : offer.From)</h3>
                @if (Items.Count == 0)
                {
                    <p class="muted">No @Words there.</p>
                }
                else
                {
                    <ul class="import-list plain-list">
                        @foreach (var (name, note) in Items)
                        {
                            var item = name;
                            <li><label><input type="checkbox" data-name="@item" checked="@_ticked.Contains(item)" @onchange="e => Tick(item, e.Value is true)" /> <span>@item</span>
                                @if (note.Length > 0)
                                {
                                    <span class="muted"> @note</span>
                                }
                            </label></li>
                        }
                    </ul>
                }
            </div>
        }
    </ChildContent>
    <Foot>
        <button type="button" class="btn ghost" @onclick="() => OnDone.InvokeAsync(null)">Cancel</button>
        <button type="button" class="btn primary" disabled="@(_offer is null || Items.Count == 0 || _importing)" @onclick="ImportAsync"><Icon Name="import" /> @(_importing ? "Importing…" : "Import")</button>
    </Foot>
</AppDialog>

@code {
    private ImportOffer? _offer;
    private HashSet<string> _ticked = [];
    private Exception? _error;
    private bool _importing;

    /// <summary>documents, connections or blades.</summary>
    [Parameter]
    public string Kind { get; set; } = "documents";

    /// <summary>Closed: what was imported, or null.</summary>
    [Parameter]
    public EventCallback<Imported?> OnDone { get; set; }

    private string Words => Kind switch
    {
        "connections" => "connections",
        "blades" => "blades",
        _ => "notebooks, scripts and apps",
    };

    private IReadOnlyList<(string Name, string Note)> Items => _offer is not { } offer ? []
        : Kind switch
        {
            "connections" => offer.Connections.Select(c => (c.Name, c.Description)).ToList(),
            "blades" => offer.Blades.Select(b => (b.Name, b.Description)).ToList(),
            _ => offer.Documents.Select(d => (d.Path, d.Made ? "made" : d.Kind)).ToList(),
        };

    private void Tick(string name, bool on)
    {
        if (on)
        {
            _ticked.Add(name);
        }
        else
        {
            _ticked.Remove(name);
        }
    }

    private async Task FromProjectAsync() => await ShowAsync(await Files.ChooseAsync("folder", "Import from a project", null, "folder"));

    private async Task FromFileAsync() => await ShowAsync(await Files.ChooseAsync("file", "Import a notebook or script", null, "notebook"));

    private async Task ShowAsync(string? from)
    {
        if (from is null)
        {
            return;
        }
        try
        {
            _offer = await ImportApi.SourcesAsync(from);
            // A loose file is the one imported: no choice to make.
            _ticked = _offer.Kind == "file" ? [.. Items.Select(i => i.Name)] : [];
            _error = null;
        }
        catch (ApiException error)
        {
            _error = error;
        }
    }

    private async Task ImportAsync()
    {
        if (_offer is not { } offer)
        {
            return;
        }
        if (_ticked.Count == 0)
        {
            _error = new InvalidOperationException("Tick what to import.");
            return;
        }
        _importing = true;
        try
        {
            var done = await ImportApi.ImportAsync(offer.From, Kind, offer.Kind == "file" ? null : _ticked.ToList());
            foreach (var name in done.Skipped)
            {
                _ = Notes.SayAsync($"{name}: the project has one by that name.");
            }
            foreach (var name in done.NeedsPassword?.Keys ?? [])
            {
                _ = Notes.SayAsync($"{name} needs a password on this computer.");
            }
            await OnDone.InvokeAsync(done);
        }
        catch (ApiException error)
        {
            _error = error;
        }
        _importing = false;
    }
}
