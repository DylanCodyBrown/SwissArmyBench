@* API.py's Endpoints panel on the Scripts page (the classic localApis.ts endpointsPane): one line (where it runs, the
   agent's session writes with Stop, New endpoint…, Run or Stop) and each endpoint (its pattern, its data, Try it, Go to
   line); with no API.py, one line. Live: local_api_changed, project_changed, file_changed. The Scripts page places it. *@
@implements IDisposable
@using SwissArmyBench.Web.Api.LocalApi
@inject LocalApiClient LocalApi
@inject LiveUpdates Live

<section class="local-api-pane" aria-label="Endpoints">
    <ErrorNote Error="_error" OnClose="() => _error = null" />
    @if (_state is null)
    {
        @if (_error is null)
        {
            <div class="loading-block">Reading API.py…</div>
        }
    }
    else if (!_state.Exists)
    {
        <p class="empty-note">The project has no API.py yet.</p>
    }
    else
    {
        <div class="local-api-pane-bar">
            <span class="local-api-dot @(_state.Running is null ? null : "on")" aria-hidden="true"></span>
            <span class="local-api-status @(_state.Running is null ? null : "on")" role="status">@(_state.Running is { } run ? $"Running on {run.Url}" : "Not running")</span>
            @if (_state.AgentWrites)
            {
                <span class="local-api-agent" title="One Allow lets the agent write through the local sandbox API for the rest of this session: the sandbox only, never live; Reset undoes it">The agent may write
                    <button type="button" class="btn small ghost" title="Stop: each of the agent's writes asks again" @onclick="StopAgentAsync"><Icon Name="stop" /> Stop</button></span>
            }
            <span class="ide-bar-gap"></span>
            <button type="button" class="btn small ghost" @onclick="() => _wizard = true"><Icon Name="plus" /> New endpoint…</button>
            @if (_state.Running is null)
            {
                <button type="button" class="btn small primary" @onclick='() => ActAsync("/local-api/run")'><Icon Name="play" /> Run</button>
            }
            else
            {
                <button type="button" class="btn small ghost" @onclick='() => ActAsync("/local-api/stop")'><Icon Name="stop" /> Stop</button>
            }
        </div>
        @if (_state.Endpoints is { Count: > 0 } endpoints)
        {
            <div class="local-api-endpoints" role="list">
                @foreach (var e in endpoints)
                {
                    <LocalEndpointRow @key="@($"{e.Method} {e.Path}")" Endpoint="e" BasePath="@(_state.Settings?.BasePath ?? string.Empty)" File="@(_state.File ?? "API.py")" />
                }
            </div>
        }
        else
        {
            <p class="empty-note">No endpoints yet: write one with @@endpoint.</p>
        }
    }
</section>
@if (_wizard)
{
    <EndpointWizard OnClose="WizardClosedAsync" />
}

@code {
    private const int SettleMilliseconds = 300;

    private LocalApiState? _state;
    private Exception? _error;
    private bool _wizard;
    private CancellationTokenSource? _settle;

    protected override async Task OnInitializedAsync()
    {
        Live.NoticeArrived += OnNotice;
        await DrawAsync();
    }

    private async Task DrawAsync()
    {
        try
        {
            _state = await LocalApi.StateAsync();
            _error = null;
        }
        catch (ApiException error)
        {
            _error = error;
        }
    }

    private async Task ActAsync(string route)
    {
        try
        {
            await LocalApi.ActAsync(route);
            await DrawAsync();
        }
        catch (ApiException error)
        {
            _error = error;
        }
    }

    private async Task StopAgentAsync()
    {
        try
        {
            await LocalApi.StopAgentWritesAsync();
            await DrawAsync();
        }
        catch (ApiException error)
        {
            _error = error;
        }
    }

    private async Task WizardClosedAsync()
    {
        _wizard = false;
        await DrawAsync();
    }

    private void OnNotice(Notice notice)
    {
        if (notice.Type is not ("local_api_changed" or "project_changed" or "file_changed"))
        {
            return;
        }
        _settle?.Cancel();
        _settle = new CancellationTokenSource();
        var token = _settle.Token;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(SettleMilliseconds, token);
            }
            catch (TaskCanceledException)
            {
                return;
            }
            await DrawAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Live.NoticeArrived -= OnNotice;
        _settle?.Cancel();
        _settle?.Dispose();
    }
}
