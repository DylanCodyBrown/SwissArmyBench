@* An extension's own panel, drawn from the data its backend answers (the classic extensionPanel.ts): its pickers, a
   dry run to review (Apply, Cancel), rows to work through (each its fix), lines, a code to copy and a page to open,
   busy words (asked again every two seconds), switches and actions. Nothing here names an extension. Kept current by
   the extension_panel_changed notice. *@
@using SwissArmyBench.Web.Api.Extensions
@implements IDisposable
@inject ExtensionsClient Extensions
@inject LiveUpdates Live
@inject Notes Notes
@inject IJSRuntime Js

<div class="extension-panel" data-panel="@Route">
    <ErrorNote Error="_error" OnClose="() => _error = null" />
    @if (_data is { } data)
    {
        @foreach (var c in data.Choices ?? [])
        {
            <label class="extension-panel-choice"><span>@c.Label</span>
                <select aria-label="@c.Label" data-choice="@c.Id" @onchange="e => PostAsync(new { choice = c.Id, value = e.Value?.ToString() })">
                    @foreach (var o in c.Options)
                    {
                        <option value="@o.Value" selected="@(o.Value == c.Value)">@o.Label</option>
                    }
                </select>
            </label>
        }
        @if (data.Review is { } r)
        {
            <section class="extension-panel-review" aria-label="@r.Heading" data-review="@r.Id">
                <h2 class="extension-panel-heading">@r.Heading</h2>
                @if (r.Items.Count > 0)
                {
                    <ul class="extension-panel-rows">
                        @foreach (var i in r.Items)
                        {
                            <li class="extension-panel-row @(i.Tone is { } t ? $"tone-{t}" : null)"><span>@i.Text</span>
                                @if (i.Why is { } why)
                                {
                                    <span class="muted"> @why</span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="extension-panel-line">@r.Empty</p>
                }
                <div class="extension-panel-controls">
                    <button type="button" class="btn primary" data-action="@r.Apply.Id" disabled="@r.Apply.Disabled" @onclick="() => PostAsync(new { action = r.Apply.Id })"><Icon Name="check" /> @r.Apply.Label</button>
                    @if (r.Cancel is { } cancel)
                    {
                        <button type="button" class="btn ghost" @onclick="() => PostAsync(new { action = cancel.Id })">@cancel.Label</button>
                    }
                </div>
            </section>
        }
        @if (data.Rows is { Count: > 0 } rows)
        {
            @if (data.Heading is { } heading)
            {
                <h2 class="extension-panel-heading">@heading</h2>
            }
            <ul class="extension-panel-rows">
                @foreach (var row in rows)
                {
                    <li class="extension-panel-row @(row.Tone is { } t ? $"tone-{t}" : null)" data-row="@row.Id"><span>@row.Text</span>
                        @if (row.Action is { } fix)
                        {
                            <button type="button" class="btn" data-action="@fix.Id" @onclick="() => PostAsync(new { action = fix.Id })">@fix.Label</button>
                        }
                    </li>
                }
            </ul>
        }
        @foreach (var line in data.Lines)
        {
            <p class="extension-panel-line @(line.Tone is { } t ? $"tone-{t}" : null)" role="@(line.Tone == "error" ? "alert" : null)">@line.Text</p>
        }
        @if (data.Code is { } said)
        {
            <div class="extension-panel-code">
                <span class="muted">@said.Label</span>
                <strong class="mono extension-panel-usercode">@said.Text</strong>
                <button type="button" class="btn ghost" @onclick="() => CopyAsync(said.Text)"><Icon Name="copy" /> Copy</button>
                @if (!said.Waiting)
                {
                    <button type="button" class="btn primary" data-action="@said.Then" @onclick="() => OpenAsync(said)"><Icon Name="popout" /> @said.LinkLabel</button>
                }
            </div>
        }
        @if (data.Busy is { } busy)
        {
            <div class="extension-panel-busy" role="status"><progress aria-label="@busy"></progress><span>@busy</span></div>
        }
        @if (data.Switches.Count > 0 || data.Actions.Count > 0)
        {
            <div class="extension-panel-controls">
                @foreach (var s in data.Switches)
                {
                    <label class="autosave-switch"><input type="checkbox" role="switch" class="switch-input" aria-label="@s.Label" data-switch="@s.Id" checked="@s.On" disabled="@s.Disabled" @onchange="e => SwitchAsync(s.Id, e)" /> <span>@s.Label</span></label>
                }
                @foreach (var a in data.Actions)
                {
                    <div class="extension-panel-action">
                        <button type="button" class="btn @(a.Primary ? "primary" : null)" data-action="@a.Id" disabled="@a.Disabled" @onclick="() => PostAsync(new { action = a.Id })">@a.Label</button>
                        @if (a.Note is { } note)
                        {
                            <p class="extension-panel-note">@note</p>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private const int BusyPollMilliseconds = 2000;

    private readonly CancellationTokenSource _gone = new();
    private PanelData? _data;
    private Exception? _error;

    /// <summary>The panel's route (GET to read it, POST to act).</summary>
    [Parameter, EditorRequired]
    public string Route { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Live.NoticeArrived += OnNotice;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            Take(await Extensions.PanelAsync(Route));
        }
        catch (ApiException error)
        {
            _error = error;
        }
    }

    private async Task PostAsync(object body)
    {
        try
        {
            Take(await Extensions.PanelPostAsync(Route, body));
            _error = null;
        }
        catch (ApiException error)
        {
            _error = error;
            await LoadAsync();
        }
    }

    /// <summary>The panel drawn; while it is busy it is asked again every two seconds.</summary>
    private void Take(PanelData data)
    {
        _data = data;
        if (data.Busy is not null)
        {
            _ = Task.Delay(BusyPollMilliseconds, _gone.Token).ContinueWith(_ => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }), TaskContinuationOptions.OnlyOnRanToCompletion);
        }
    }

    private Task SwitchAsync(string id, ChangeEventArgs e) =>
        PostAsync(new Dictionary<string, object?> { ["switch"] = id, ["on"] = e.Value is true });

    private async Task CopyAsync(string text)
    {
        if (await Js.InvokeAsync<bool>("sab.copy", text))
        {
            _ = Notes.SayAsync("Copied.");
        }
        else
        {
            _error = new ApiException(0, new Refusal("The browser blocked the clipboard."), string.Empty);
        }
    }

    /// <summary>The page opens on the user's click (https only), then its action is posted.</summary>
    private async Task OpenAsync(PanelCode code)
    {
        if (code.Link.StartsWith("https://", StringComparison.Ordinal))
        {
            await Js.InvokeVoidAsync("open", code.Link, "_blank", "noopener");
        }
        await PostAsync(new { action = code.Then });
    }

    private void OnNotice(Notice notice)
    {
        if (notice.Type == "extension_panel_changed")
        {
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        Live.NoticeArrived -= OnNotice;
        _gone.Cancel();
        _gone.Dispose();
    }
}
