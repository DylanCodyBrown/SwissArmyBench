@* The Extensions page (the classic extensionsPage.ts): New extension… in its heading; a card per extension (its
   name, status: Preinstalled, Available, Installed, Installed (folder), Coming; its version, what it does and adds,
   the project type it adds, a folder's path, its error, its note, its own panel), Install and Remove (asked first when
   the server would), Install's progress through the app's restart; a folder extension's Install <packages>, Load
   again, Remove and Show its folder. Logic in ExtensionsPage.razor.cs. *@
@page "/extensions"
@using SwissArmyBench.Web.Api.Extensions
@implements IDisposable

<section class="area-page">
    <header class="area-page-head">
        <h1 class="area-page-title">Extensions</h1>
        <div class="area-page-actions"><button type="button" class="btn extension-new" @onclick="() => _newing = true"><Icon Name="plus" /> New extension…</button></div>
    </header>
    <div class="area-page-body extensions-page">
        <ErrorNote Error="_error" OnRetry="LoadAsync" OnClose="() => _error = null" />
        <div class="extension-cards">
            @foreach (var ext in _list?.Extensions ?? [])
            {
                <article class="extension-card @ext.Status" data-extension="@ext.Id" aria-disabled="@(ext.Status == "coming" ? "true" : null)" data-installable="@(_list!.Installable ? "true" : "false")">
                    <header class="extension-head">
                        <span class="extension-name"><Icon Name="extensions" /> @ext.Name</span>
                        <span class="extension-status status-@ext.Status">@StatusWords(ext)</span>
                        @if (ext.Version is { } version)
                        {
                            <span class="extension-version muted">@version</span>
                        }
                    </header>
                    <p class="extension-description">@ext.Description</p>
                    @if (ext.Adds.Count > 0)
                    {
                        <ul class="extension-adds">
                            @foreach (var adds in ext.Adds)
                            {
                                <li>@adds</li>
                            }
                        </ul>
                    }
                    @if (ProjectLine(ext) is { } project)
                    {
                        <p class="extension-project muted">@project</p>
                    }
                    @if (ext.Path is { } path)
                    {
                        <p class="extension-path muted" title="@path">@path</p>
                    }
                    @if (ext.Error is { } problem)
                    {
                        <ErrorNote Error="@(new ApiException(0, new Refusal(problem, ext.Name), string.Empty))" />
                    }
                    @if (ext.Note is { } note)
                    {
                        <p class="extension-said" role="status">@note</p>
                    }
                    @if (ext.Panel is { } panel && ext.Status == "installed")
                    {
                        <ExtensionPanel Route="@panel" />
                    }
                    <div class="extension-foot @(ext.Source == "folder" ? "folder" : null)">
                        @Foot(ext)
                        @if (_said.GetValueOrDefault(ext.Id) is { } said)
                        {
                            <p class="extension-said" role="status">@said</p>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
@if (_newing)
{
    <NewExtensionDialog OnDone="NewDoneAsync" />
}
@if (_asking is { } asking)
{
    <AppDialog Title="@($"Remove {asking.Ext.Name}")" OnClose="() => _asking = null">
        <ChildContent><p>@asking.Question</p></ChildContent>
        <Foot>
            <button type="button" class="btn" @onclick="() => _asking = null">Cancel</button>
            <button type="button" class="btn danger" @onclick="ConfirmedAsync">Remove @asking.Ext.Name</button>
        </Foot>
    </AppDialog>
}

@code {
    /// <summary>A card's foot: a folder's own actions, the progress of a change, Install or Remove.</summary>
    private RenderFragment Foot(ExtensionInfo ext) => __builder =>
    {
        if (ext.Source == "folder")
        {
            if (ext.Missing is { } missing)
            {
                <Busy IsBusy="_busy == ext.Id" Words="Installing…"><button type="button" class="btn primary extension-install" title="@missing.Command" @onclick="() => LoadAgainAsync(ext)"><Icon Name="import" /> Install @string.Join(", ", missing.Packages)</button></Busy>
            }
            else if (ext.Error is not null)
            {
                <Busy IsBusy="_busy == ext.Id" Words="Loading…"><button type="button" class="btn extension-load" @onclick="() => LoadAgainAsync(ext)"><Icon Name="reset" /> Load again</button></Busy>
            }
            <button type="button" class="btn extension-remove" @onclick='() => ChangeAsync(ext, "remove", false)'><Icon Name="trash" /> Remove</button>
            <button type="button" class="btn ghost extension-show" @onclick="() => ShowAsync(ext)"><Icon Name="folder" /> Show its folder</button>
        }
        else if (_changing is { } changing && changing.Id == ext.Id)
        {
            <progress class="extension-progress" aria-label="@StageWords(ext.Name, changing.Action)"></progress>
            <p class="extension-stage" role="status">@StageWords(ext.Name, changing.Action)</p>
        }
        else if (ext.Status == "available")
        {
            <Busy IsBusy="_busy == ext.Id" Words="Installing…"><button type="button" class="btn primary extension-install" disabled="@(_changing is not null)" @onclick='() => ChangeAsync(ext, "install", false)'><Icon Name="import" /> Install</button></Busy>
        }
        else if (ext.Status == "installed")
        {
            <Busy IsBusy="_busy == ext.Id" Words="Removing…"><button type="button" class="btn extension-remove" disabled="@(_changing is not null)" @onclick='() => ChangeAsync(ext, "remove", false)'><Icon Name="trash" /> Remove</button></Busy>
        }
    };
}
