@* Add a note, or edit one (the classic aiPanel.ts noteDialog): its title and its Markdown. *@
@using SwissArmyBench.Web.Api.Analyze
@inject BoardClient Board

<AppDialog Title="@(Existing is null ? "Add a note" : "Edit the note")" OnClose="OnClose">
    <ChildContent>
        <label class="field"><span>Title</span><input type="text" aria-label="Title" placeholder="Optional" @bind="_title" /></label>
        <label class="field"><span>Note (markdown)</span><textarea rows="14" aria-label="Note (markdown)" placeholder="Markdown" @bind="_body"></textarea></label>
        <ErrorNote Error="_error" OnClose="() => _error = null" />
    </ChildContent>
    <Foot>
        <button type="button" class="btn" @onclick="OnClose">Cancel</button>
        <button type="button" class="btn primary" @onclick="SaveAsync">@(Existing is null ? "Add note" : "Save")</button>
    </Foot>
</AppDialog>

@code {
    private string _title = string.Empty;
    private string _body = string.Empty;
    private Exception? _error;

    /// <summary>The note card edited (null: a new note).</summary>
    [Parameter]
    public BoardCard? Existing { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Saved: the board reads its cards again.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    protected override void OnInitialized() => (_title, _body) = (Existing?.Title ?? string.Empty, Existing?.Body ?? string.Empty);

    private async Task SaveAsync()
    {
        try
        {
            if (Existing is { } card)
            {
                await Board.PatchAsync(card.Id, new Dictionary<string, object?> { ["title"] = _title, ["body"] = _body });
            }
            else
            {
                await Board.AddNoteAsync(_title, _body);
            }
            await OnSaved.InvokeAsync();
        }
        catch (ApiException error)
        {
            _error = error;
        }
    }
}
