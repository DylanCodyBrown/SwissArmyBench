@* The viewer beside the list (the classic environmentPage.ts): the row picked, whole: what it is, its size and
   value, where it comes from, every place that uses it, and its parts (a table's columns with their types and
   ranges). *@

<aside class="side-pane environment-viewer" aria-label="@($"About {Shown.Name}")">
    <div class="side-pane-head">
        <strong>@Shown.Name</strong> <span class="chip">@Shown.Type</span>
        <span class="status-spacer"></span>
        <button type="button" class="btn ghost icon small" aria-label="Close the viewer" @onclick="OnClose"><Icon Name="close" /></button>
    </div>
    <dl class="terms side-pane-note">
        @if (Shown.Size.Length > 0)
        {
            <dt>Size</dt><dd>@Shown.Size</dd>
        }
        @if (Shown.Value.Length > 0)
        {
            <dt>Value</dt><dd>@Shown.Value</dd>
        }
        @if (Shown.From.Length > 0)
        {
            <dt>From</dt><dd>@Shown.From</dd>
        }
    </dl>
    @if (Parts.Count > 0)
    {
        <table class="rows environment-parts">
            <tbody>
                @foreach (var part in Parts)
                {
                    <tr>@foreach (var word in part)
                        {
                            <td>@word</td>
                        }</tr>
                }
            </tbody>
        </table>
        @if (Shown.MoreKids > 0)
        {
            <p class="muted side-pane-note">and @Shown.MoreKids.ToString("N0") more</p>
        }
    }
    <div class="side-pane-note">
        <strong>Used in</strong>
        @if ((Shown.Used ?? []).Count == 0)
        {
            <p class="muted">Nothing uses it yet.</p>
        }
        <ul class="plain-list">
            @foreach (var use in Shown.Used ?? [])
            {
                <li>@use.Words</li>
            }
        </ul>
    </div>
</aside>

@code {
    [Parameter, EditorRequired]
    public EnvironmentShown Shown { get; set; } = default!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Its parts as rows of words (each part is a list: a column's name, type and range).</summary>
    private IReadOnlyList<IReadOnlyList<string>> Parts =>
        Shown.Kids is { ValueKind: System.Text.Json.JsonValueKind.Array } kids
            ? kids.EnumerateArray()
                .Select(k => k.ValueKind == System.Text.Json.JsonValueKind.Array
                    ? (IReadOnlyList<string>)k.EnumerateArray().Select(w => w.ValueKind == System.Text.Json.JsonValueKind.String ? w.GetString() ?? string.Empty : w.GetRawText()).ToList()
                    : [k.ValueKind == System.Text.Json.JsonValueKind.String ? k.GetString() ?? string.Empty : k.GetRawText()])
                .ToList()
            : [];
}
