@* Add variable (the classic variableLinks.ts): its name (upper case, letters, digits and _), its value, and how it is
   kept: a plain value (shareable in the library), this computer only, or a secret in the keyring (a name that reads
   as a secret starts there). The value is never shown again once a secret. *@

<AppDialog Title="Add variable" OnClose="OnClose">
    <ChildContent>
        <form class="list-editor" aria-label="Add variable" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
            <label class="field"><span>Name</span><input aria-label="Name" value="@_name" @oninput="NameTyped" autocomplete="off" /></label>
            <label class="field"><span>Value</span><input aria-label="Value" type="@(_kept == Keyring ? "password" : "text")" autocomplete="off" spellcheck="false" @bind="_value" /></label>
            <label class="field"><span>Kept</span>
                <select aria-label="Kept" value="@_kept" @onchange="KeptChanged">
                    <option value="@Plain">Plain value</option>
                    <option value="@Local">This computer only</option>
                    <option value="@Keyring">Keyring (secret)</option>
                </select>
            </label>
            <ErrorNote Error="_error" OnClose="() => _error = null" />
        </form>
    </ChildContent>
    <Foot>
        <button type="button" class="btn" @onclick="OnClose">Cancel</button>
        <button type="button" class="btn primary" disabled="@(_name.Length == 0)" @onclick="SaveAsync">Add</button>
    </Foot>
</AppDialog>

@code {
    private const string Plain = "value";
    private const string Local = "local";
    private const string Keyring = "keyring";

    private string _name = string.Empty;
    private string _value = string.Empty;
    private string _kept = Plain;
    private bool _picked;
    private Exception? _error;

    [Inject]
    private EnvironmentClient Environment { get; set; } = default!;

    [Inject]
    private Notes Notes { get; set; } = default!;

    /// <summary>A setting's name to change (Change…), or empty for a new one.</summary>
    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnAdded { get; set; }

    protected override void OnInitialized() => _name = Name;

    private void NameTyped(ChangeEventArgs e)
    {
        _name = System.Text.RegularExpressions.Regex.Replace((e.Value?.ToString() ?? string.Empty).ToUpperInvariant(), "[^A-Z0-9_]", "_");
        if (!_picked)
        {
            _kept = System.Text.RegularExpressions.Regex.IsMatch(_name, "PASSWORD|PASSWD|SECRET|TOKEN|API_?KEY|PRIVATE") ? Keyring : Plain;
        }
    }

    private void KeptChanged(ChangeEventArgs e)
    {
        _kept = e.Value?.ToString() ?? Plain;
        _picked = true;
    }

    private async Task SaveAsync()
    {
        try
        {
            await Environment.SetVariableAsync(_name.Trim(), _value, _kept == Keyring, _kept == Local);
            _ = Notes.SayAsync($"Added {_name.Trim()}");
            await OnAdded.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (ApiException error)
        {
            _error = error;
        }
    }
}
