@* The Environment (the classic environmentPage.ts mountEnvironment): everything the project holds, a tab per kind
   (Tables, Variables, Structures, Settings and secrets, Libraries) with its own columns (each hides from the Columns
   menu, kept per tab), one search over every tab (each tab's count lights up, a line names the others that match, the
   match marked, a row that matched inside opens there), rows that unfold (a table's columns with ranges, a structure's
   paths), the viewer beside the list (Ctrl+B), each row's actions (its menu), the keys (arrows, Enter, F2, Del, /). It
   follows environment_changed by itself. The page (EnvironmentPage.razor: At, RowName in the address) and the
   Workbench's pane (EnvironmentPane.razor: Compact) draw it. Logic in EnvironmentView.razor.cs, .Actions.cs, .Keys.cs. *@

@if (Compact)
{
    <div class="env-pane-body" @onkeydown="KeyAsync">
        @EnvBody
    </div>
}
else
{
    <section class="area-page" @onkeydown="KeyAsync">
        <header class="area-page-head">
            <h1 class="area-page-title">Environment <span class="env-project">@_answer?.Project?.Name</span></h1>
            <div class="area-page-actions">
                <button type="button" class="btn ghost env-clear" title="Clear what is not kept…" @onclick="ClearAsync">Clear…</button>
            </div>
        </header>
        <div class="area-page-body env-page-body">
            @EnvBody
        </div>
    </section>
}
@if (_menu is { } menu)
{
    <ContextMenu Title="@menu.Title" Entries="menu.Entries" X="menu.X" Y="menu.Y" OnClose="() => _menu = null" />
}
@if (_renaming is { } renaming)
{
    <EnvRenameDialog Item="renaming" OnDone="RenamedAsync" />
}
@if (_removing is { } removing)
{
    <EnvRemoveDialog Item="removing" PythonToo="_pythonToo" OnDone="RemovedAsync" />
}
@if (_clearing is { } clearing)
{
    <EnvClearDialog Choices="clearing" OnDone="ClearedAsync" />
}
@if (_installing)
{
    <InstallLibraryDialog OnDone="InstallTypedAsync" />
}
@if (_variantOf is { } variantOf)
{
    <SwissArmyBench.Web.Pages.Connections.Sandbox.SandboxVariantDialog Origin="@variantOf" OnClose="VariantClosedAsync" />
}
@if (_setting is { } setting)
{
    <VariableAddDialog Name="@setting" OnClose="() => _setting = null" OnAdded="SettingAddedAsync" />
}

@code {
    private static readonly string _passwordWords = "$" + "{NAME}";

    /// <summary>One row and, unfolded, its parts (a table's columns, a structure's paths).</summary>
    private RenderFragment RowOf(EnvironmentItem item) => __builder =>
    {
        var columns = Shown(item.Kind);
        var kids = KidsOf(item);
        var open = IsOpen(item);
        var inside = _query.Length > 0 && item.Match is { Own: false };
        <div class="env-row @(_selected == item.Id ? "sel" : null)" role="treeitem" tabindex="@(_selected == item.Id ? 0 : -1)" aria-selected="@(_selected == item.Id ? "true" : "false")" aria-level="1" aria-expanded="@(kids.Count > 0 ? (open ? "true" : "false") : null)" data-id="@item.Id" data-name="@item.Name" @onclick="() => Select(item.Id)" @ondblclick="() => OpenItemAsync(item)">
            <span class="env-twist" data-twist="@item.Id" aria-hidden="true" @onclick="() => ToggleAsync(item, null)" @onclick:stopPropagation="true">@(kids.Count > 0 ? (open ? "▾" : "▸") : string.Empty)</span>
            <span class="env-name">
                <span class="env-kind env-k-@(item.Sub is "secret" or "sandbox" ? item.Sub : item.Kind)" title="@_tabWords[item.Kind]" aria-hidden="true"></span>
                <span>@Marked(item.Name)</span>
                @foreach (var tag in item.Tags ?? [])
                {
                    <span class="env-tag @(tag == "Keep" ? "env-tag-keep" : null)">@tag</span>
                }
                @if (inside)
                {
                    <span class="env-why">matched inside</span>
                }
            </span>
            @foreach (var column in columns)
            {
                <EnvCell Item="item" Head="@column.Head" Query="@_query" Revealed="@_revealed.GetValueOrDefault(item.Id)" Checked="@(_answer?.Checked ?? false)" OnUsed="() => Select(item.Id, true)" OnPin="() => PinAsync(item, !item.Pinned)" OnUpdate="() => UpdateAsync(item)" />
            }
            <button type="button" class="env-more" aria-label="@($"Actions for {item.Name}")" title="Actions" @onclick="e => RowMenu(item, e.ClientX, e.ClientY)" @onclick:stopPropagation="true"><Icon Name="more" /></button>
        </div>
        @if (open)
        {
            var wanted = inside ? item.Match!.Kids.ToHashSet() : null;
            @foreach (var (kid, i) in kids.Select((k, i) => (k, i)).Where(x => wanted is null || wanted.Contains(x.i)))
            {
                <div class="env-row env-child" role="treeitem" aria-level="2" data-parent="@item.Id">
                    <span></span>
                    <span class="env-name"><span>@Marked(kid.ElementAtOrDefault(0) ?? string.Empty)</span></span>
                    <span class="env-type">@Marked(kid.ElementAtOrDefault(1) ?? string.Empty)</span>
                    <span class="env-val" style="grid-column: span @Math.Max(1, columns.Count - 1)">@Marked(kid.ElementAtOrDefault(2) ?? string.Empty)</span>
                    <span></span>
                </div>
            }
            @if (item.MoreKids > 0)
            {
                <div class="env-row env-child env-more-kids"><span></span><span class="env-none" style="grid-column: span @(columns.Count + 1)">and @item.MoreKids more</span><span></span></div>
            }
        }
    };

    /// <summary>A text with the search's words marked.</summary>
    private RenderFragment Marked(string text) => __builder =>
    {
        foreach (var (part, marked) in TextMarks.Of(text, _query))
        {
            if (marked)
            {
                <mark>@part</mark>
            }
            else
            {
                @part
            }
        }
    };

    /// <summary>The list and its viewer: the page's body, and the pane's.</summary>
    private RenderFragment EnvBody => @<div class="env @(Compact ? "env-compact" : null) @(_folded ? "env-folded" : null)">
        <div class="env-main">
            <section class="env-page" aria-label="Environment list">
                @if (_answer is { Python: { } python } answer)
                {
                    <div class="env-session">
                        <span class="env-python" title="@python.Python">Python @python.Version · @PythonWords(python, answer)</span>
                        <span>tables in memory @answer.Memory · nothing is saved unless you tick Keep</span>
                        <span class="env-grow"></span>
                        <span>Updates by itself as your code runs · tables are added on the <a class="env-link" href="connections">Connections</a> page</span>
                    </div>
                }
                <div class="env-tabs" role="tablist" aria-label="_kinds">
                    @foreach (var kind in _kinds)
                    {
                        var count = _answer?.Counts.GetValueOrDefault(kind) ?? 0;
                        <button type="button" class="env-tab" role="tab" data-kind="@kind" aria-selected="@(kind == _tab ? "true" : "false")" tabindex="@(kind == _tab ? 0 : -1)" @onclick="() => SetTabAsync(kind)">
                            @_tabWords[kind] <i class="@(_query.Length > 0 && count > 0 ? "hot" : null)" data-count="@kind">@count</i>
                        </button>
                    }
                </div>
                <div class="env-find">
                    <input type="search" class="env-search" placeholder="Search every tab: names, columns, keys, variables, where used…" aria-label="Search the environment" autocomplete="off" spellcheck="false" data-no-variables value="@_typed" @oninput="SearchTyped" @ref="_searchBox" />
                    <span class="env-hint" role="status">
                        @if (_query.Length > 0 && OtherTabs.Count > 0)
                        {
                            <text>Also matches in </text>
                            @foreach (var (other, i) in OtherTabs.Select((k, i) => (k, i)))
                            {
                                @(i > 0 ? ", " : string.Empty)<button type="button" class="env-link" data-go="@other" @onclick="() => SetTabAsync(other)">@_tabWords[other] (@(_answer?.Counts.GetValueOrDefault(other) ?? 0))</button>
                            }
                        }
                    </span>
                    <span class="env-tools">
                        @if (_tab == Library)
                        {
                            var outdated = Rows(Library).Where(i => i.Latest is not null && !i.Pinned).ToList();
                            if (outdated.Count > 0)
                            {
                                <button type="button" class="btn env-update-all" @onclick="() => UpdateAllAsync(outdated)">Update all not pinned (@outdated.Count)</button>
                            }
                            <button type="button" class="btn primary env-install" title="Installs into the project's environment and adds it to requirements.txt" @onclick="() => _installing = true"><Icon Name="import" /> Install a library…</button>
                        }
                        @if (_tab == Structure)
                        {
                            <a class="btn env-structures" href="structures"><Icon Name="plus" /> New, open or paste…</a>
                        }
                        @if (_tab == Setting)
                        {
                            <button type="button" class="btn primary env-add-setting" @onclick="() => AddSetting(string.Empty)"><Icon Name="plus" /> Add a setting…</button>
                        }
                    </span>
                </div>
                <div class="env-project-lines">
                    @if (_tab == Library && _answer?.Python is { Status: not "none" } line)
                    {
                        <div class="env-project-python @line.Status" role="status">
                            <span class="env-project-python-words" title="@(line.Problem ?? line.Python)">@line.Words</span>
                            @if (line.Status is "missing" or "failed")
                            {
                                <button type="button" class="btn line env-make-python" title="Makes .venv in the project's folder with the libraries requirements.txt names" @onclick="MakePythonAsync">@(line.Status == "failed" ? "Try again" : "Make it now")</button>
                            }
                            @if (line.Session is { } session)
                            {
                                <span class="env-project-session" title="@session">One Python session for the whole project</span>
                            }
                        </div>
                    }
                    @foreach (var offer in _answer?.Python?.Offers ?? [])
                    {
                        <div class="env-offer" role="note">
                            <span>@offer.Words</span>
                            @if (offer.Libraries.Count > 0)
                            {
                                <button type="button" class="btn line env-offer-add" title="@($"Installs {string.Join(", ", offer.Libraries)} into the project's Python and adds them to requirements.txt")" @onclick="() => AnswerOfferAsync(offer, true)">@(offer.Libraries.Count == 1 ? "Add it" : "Add them")</button>
                                <button type="button" class="btn ghost env-offer-skip" @onclick="() => AnswerOfferAsync(offer, false)">Not now</button>
                            }
                        </div>
                    }
                </div>
                @if (_tab == Setting)
                {
                    <p class="hint env-vaults-moved"><Icon Name="key" /> Key vaults are on the <a href="connections">Connections page</a>; the variables they give are listed here.</p>
                }
                <ErrorNote Error="_error" OnRetry="LoadAsync" OnClose="() => _error = null" />
                <div class="env-list" role="tree" aria-label="Everything the project holds" tabindex="-1" style="@ListColumns">
                    @if (_answer is null)
                    {
                        <div class="loading-block">Loading the environment…</div>
                    }
                    else
                    {
                        <div class="env-head" role="presentation" @oncontextmenu="e => ColumnsMenu(e.ClientX, e.ClientY)" @oncontextmenu:preventDefault="true">
                            <span></span><span>Name</span>
                            @foreach (var column in Shown(_tab))
                            {
                                <span>@column.Head</span>
                            }
                            <button type="button" class="env-columns" aria-label="Columns" title="Show or hide columns" @onclick="e => ColumnsMenu(e.ClientX, e.ClientY)"><Icon Name="more" /></button>
                        </div>
                        @if (Rows(_tab).Count == 0)
                        {
                            @if (_tab == Setting && _query.Length == 0)
                            {
                                <div class="empty-state">
                                    <Icon Name="variables" />
                                    <p>A setting is a value typed once, such as a server's name or a password, then written @_passwordWords in any box.</p>
                                    <button type="button" class="btn primary" @onclick="() => AddSetting(string.Empty)"><Icon Name="plus" /> Add a setting…</button>
                                </div>
                            }
                            else
                            {
                                <div class="env-empty">@EmptyWords</div>
                            }
                        }
                        @foreach (var item in Rows(_tab))
                        {
                            @RowOf(item)
                        }
                    }
                </div>
            </section>
            <EnvironmentSide Item="Selected" Actions="@(Selected is { } s ? ActionsOf(s) : [])" Folded="_folded" OnFold="FoldAsync" OnFollow="FollowAsync" @bind-PythonToo="_pythonToo" />
        </div>
    </div>;
}
