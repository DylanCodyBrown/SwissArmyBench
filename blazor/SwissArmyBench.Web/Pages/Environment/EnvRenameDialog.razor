@* Rename a row (the classic environmentPage.ts renameDialog): its new name; Enter renames. *@
@inject EnvironmentClient Environment

<AppDialog Title="@($"Rename {Item.Name}")" OnClose="() => OnDone.InvokeAsync(null)">
    <ChildContent>
        <label class="field"><span>New name</span><input type="text" class="mono" aria-label="New name" spellcheck="false" data-no-variables @bind="_to" @bind:event="oninput" @onkeydown="KeyAsync" /></label>
        <ErrorNote Error="_error" OnClose="() => _error = null" />
    </ChildContent>
    <Foot>
        <button type="button" class="btn ghost" @onclick="() => OnDone.InvokeAsync(null)">Cancel</button>
        <Busy IsBusy="_busy" Words="Renaming…"><button type="button" class="btn primary" @onclick="RenameAsync">Rename</button></Busy>
    </Foot>
</AppDialog>

@code {
    private string _to = string.Empty;
    private bool _busy;
    private Exception? _error;

    [Parameter, EditorRequired]
    public EnvironmentItem Item { get; set; } = default!;

    /// <summary>The new name once renamed; null when closed.</summary>
    [Parameter]
    public EventCallback<string?> OnDone { get; set; }

    protected override void OnInitialized() => _to = Item.Name;

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RenameAsync();
        }
    }

    private async Task RenameAsync()
    {
        if (_busy)
        {
            return; // the rename is already on its way (Enter twice)
        }
        _busy = true;
        try
        {
            await Environment.RenameAsync(Item.Kind, Item.Name, _to.Trim());
            await OnDone.InvokeAsync(_to.Trim());
        }
        catch (ApiException error)
        {
            _error = error;
        }
        _busy = false;
    }
}
