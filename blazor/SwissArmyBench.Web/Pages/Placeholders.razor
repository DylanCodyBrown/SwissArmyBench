@* The rail's areas this front end does not draw yet: each its address, one line and its classic place. *@
@page "/{Area}"

@if (Found is { } area)
{
    <NotYet Title="@area.Name" Classic="@area.Classic" />
}
else
{
    <NotYet Title="This page" Classic="/workspace" />
}

@code {
    [Parameter]
    public string Area { get; set; } = string.Empty;

    private RailArea? Found => Areas.All.FirstOrDefault(a => a.Route == Area)
        ?? (Area.StartsWith("x-", StringComparison.Ordinal) ? new RailArea(Area[2..], Area[2..], "extensions", Area, $"/workspace?open={Area[2..]}") : null);
}
