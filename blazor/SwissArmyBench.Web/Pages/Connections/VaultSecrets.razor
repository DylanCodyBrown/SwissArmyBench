@* A key vault's secrets on its form (the classic connectionsWindow.ts secretsBox): Every secret in the vault (a new
   vault's default: each under its own name, new ones too), Read the vault (its names, never a value), each secret a
   row (Use it, its name, the variable it is set as: empty, the vault's own name), a name typed and Add, Filter past
   ten rows. A name another source gives is said before saving. Logic in VaultSecrets.razor.cs. *@

<fieldset class="connection-passwords vault-secrets">
    <legend>Secrets</legend>
    <label class="vault-every"><input type="checkbox" aria-label="Every secret in the vault" @bind="Every" /> <span>Every secret in the vault</span></label>
    <div class="field-row">
        <button type="button" class="btn" @onclick="ReadAsync"><Icon Name="import" /> Read the vault</button>
        @if (_rows.Count > 10)
        {
            <input type="search" placeholder="Filter" aria-label="Filter the secrets" @bind="_filter" @bind:event="oninput" />
        }
    </div>
    @if (_reading)
    {
        <p class="hint">Reading the vault…</p>
    }
    else if (_said is not null)
    {
        <p class="@(_listed ? "status-ok" : "hint")">@_said</p>
    }
    <ErrorNote Error="_error" OnRetry="ReadAsync" OnClose="() => _error = null" />
    <table class="vault-map rows @(Every ? "every" : null)">
        <thead><tr><th></th><th>In the vault</th><th>Environment variable</th></tr></thead>
        <tbody>
            @foreach (var row in _rows.Where(Shown))
            {
                <tr data-secret="@row.Secret">
                    <td><input type="checkbox" aria-label="@($"Use {row.Secret}")" @bind="row.Use" /></td>
                    <td><code>@row.Secret</code></td>
                    <td>
                        <input type="text" class="mono" spellcheck="false" placeholder="@VaultRow.EnvFor(row.Secret)" aria-label="@($"{row.Secret}: the variable's name")" value="@row.Variable" @oninput="e => Typed(row, e.Value?.ToString() ?? string.Empty)" />
                        @if (TakenBy(row) is { } by)
                        {
                            <span class="error-mark"><Icon Name="problem" /> @row.Variable.Trim() is already a variable (from @by). Pick another name.</span>
                        }
                    </td>
                </tr>
            }
            <tr class="vault-new">
                <td></td>
                <td><input type="text" placeholder="Secret name" spellcheck="false" aria-label="A secret's name in the vault" @bind="_newSecret" @bind:event="oninput" @onkeydown="NewKeyAsync" @ref="_newBox" /></td>
                <td><button type="button" class="btn small" @onclick="AddTypedAsync"><Icon Name="plus" /> Add</button></td>
            </tr>
        </tbody>
    </table>
</fieldset>
